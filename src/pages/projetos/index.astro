---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import GlitchWordmark from '@/components/ui/GlitchWordmark.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { getProjects } from '@/lib/projects';
import { projectsPage } from '@/data/projects';

const projects = await getProjects();
// O arquivo termina sempre com o cartão do próximo projeto.
const slots = projects.length + 1;
const range = (n: number) => String(n).padStart(3, '0');
---

<BaseLayout title={projectsPage.title} description={projectsPage.description}>
  <section class="site-container page" aria-labelledby="page-title">
    <PageHeader eyebrow={projectsPage.eyebrow} title={projectsPage.title} index={String(projects.length).padStart(2, '0')}>
      <GlitchWordmark slot="title" text={projectsPage.title} src="/images/projetos-glitch" width={368} height={84} inset={65} />
      <p class="intro">{projectsPage.description}</p>
    </PageHeader>

    <section class="archive" aria-labelledby="archive-title">
      <h2 id="archive-title" class="archive__head">
        <span>// {projectsPage.archiveLabel}</span>
        <span class="archive__range" aria-label={`${projects.length} projetos publicados`}>[ {range(1)} – {range(slots)} ]</span>
      </h2>

      <ul class="archive__grid">
        {projects.map((project, i) => (
          <li><ProjectCard project={project} index={i} headingLevel="h3" layout="archive" /></li>
        ))}
        <li><ProjectCard upcoming={projectsPage.nextProject} index={projects.length} headingLevel="h3" layout="archive" /></li>
      </ul>
    </section>
  </section>
</BaseLayout>

<style>
  /*
   * Composição da referência (1586 px): título e descrição recuados 18 px em
   * relação ao rótulo, divisória sob a introdução e arquivo em três colunas de
   * 340 px alinhadas à esquerda.
   */
  .page {
    padding: 4.0625rem 0 6rem;
  }

  .page :global(.page-head) {
    padding-bottom: 2.25rem;
  }

  .page :global(.page-head__title) {
    margin: -0.1875rem 0 0 1.125rem;
  }

  /* Sem arte atrás do título: o fundo da página dá ao GIF algo com que se misturar. */
  .page :global(.wordmark) {
    background: var(--color-void);
  }

  .intro {
    max-width: 25rem;
    margin: 0.25rem 0 0 1.125rem;
    font-size: 0.75rem;
    line-height: 1.25rem;
    color: var(--color-ash);
  }

  .archive {
    margin-top: 1.5rem;
  }

  .archive__head {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-ash);
  }

  .archive__head::after {
    content: '';
    flex: 1;
    height: 1px;
    margin-left: -0.5rem;
    background: var(--color-line);
  }

  .archive__range {
    letter-spacing: 0.12em;
    color: var(--color-smoke);
  }

  .archive__grid {
    display: grid;
    grid-template-columns: repeat(3, 21.25rem);
    gap: 1.75rem;
    margin-top: 1rem;
  }

  .archive__grid > li {
    display: flex;
  }

  .archive__grid > li > :global(*) {
    flex: 1;
  }

  @media (max-width: 1139px) {
    .archive__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .page :global(.page-head__title),
    .intro {
      margin-left: 0;
    }

    .archive__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
