---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { getProjects } from '@/lib/projects';
import { projectsIntro } from '@/data/home';

const projects = await getProjects();
---

<BaseLayout title="Projetos" description={projectsIntro.description}>
  <section class="site-container page" aria-labelledby="page-title">
    <PageHeader
      eyebrow={projectsIntro.eyebrow}
      title={projectsIntro.title}
      description={projectsIntro.description}
      index={String(projects.length).padStart(2, '0')}
    />

    <ul class="page__grid">
      {projects.map((project, i) => (
        <li><ProjectCard project={project} index={i} headingLevel="h2" /></li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .page {
    padding: 3.5rem 0 6rem;
  }

  .page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 2.125rem;
    margin-top: 2.5rem;
  }

  .page__grid > li {
    display: flex;
  }

  .page__grid > li > :global(*) {
    flex: 1;
  }
</style>
