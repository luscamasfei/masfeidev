---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { getProjects } from '@/lib/projects';
import { projectsIntro } from '@/data/home';

const projects = await getProjects();
---

<BaseLayout title="Projetos" description={projectsIntro.description}>
  <section class="site-container page" aria-labelledby="page-title">
    <header class="page__head">
      <p class="page__eyebrow">// {projectsIntro.eyebrow}</p>
      <h1 id="page-title" class="page__title">{projectsIntro.title}</h1>
      <p class="page__description">{projectsIntro.description}</p>
      <p class="section-index page__index" aria-hidden="true">[ {String(projects.length).padStart(2, '0')} ]</p>
    </header>

    <ul class="page__grid">
      {projects.map((project, i) => (
        <li><ProjectCard project={project} index={i} headingLevel="h2" /></li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .page {
    padding: 3.5rem 0 6rem;
  }

  .page__head {
    position: relative;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .page__eyebrow {
    font-size: 0.65625rem;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-ash);
  }

  .page__title {
    margin-top: 0.85rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
  }

  .page__description {
    margin-top: 1.1rem;
    max-width: 24rem;
    font-size: 0.75rem;
    line-height: 1.15rem;
    color: var(--color-ash);
  }

  .page__index {
    position: absolute;
    top: 0;
    right: 0;
  }

  .page__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 2.125rem;
    margin-top: 2.5rem;
  }

  .page__grid > li {
    display: flex;
  }

  .page__grid > li > :global(*) {
    flex: 1;
  }
</style>
