---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada">
  <section class="site-container py-24">
    <p class="eyebrow">// 404</p>
    <h1 class="mt-4 font-serif text-[2.25rem] leading-tight">Sinal perdido</h1>
    <p class="mt-4 text-ash">Esta página não existe ou mudou de lugar.</p>
    <a href="/" class="mt-8 inline-flex border border-line-strong px-4 py-2 text-[0.75rem] hover:border-paper">Voltar ao início</a>
  </section>
</BaseLayout>
