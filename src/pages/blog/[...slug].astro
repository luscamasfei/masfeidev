---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, isoDate, longDate, postHref, readingMinutes, tagHref, type Post } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // A lista vem do mais recente para o mais antigo.
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, summary, date, updated, tags, draft } = post.data;
const { Content, headings } = await render(post);
// O sumário só aparece em artigos longos, com várias seções.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = headings.filter((h) => h.depth === 2).length >= 3;
---

<BaseLayout title={title} description={summary} article={{ published: date, modified: updated, tags }}>
  <article class="site-container article" aria-labelledby="article-title">
    <a href="/blog/" class="article__back">
      <svg width="12" height="10" viewBox="0 0 12 10" aria-hidden="true"><path d="M12 5H1.5M5.5 1l-4 4 4 4" fill="none" stroke="currentColor" stroke-width="1.1" /></svg>
      Todos os logs
    </a>

    <header class="article__head">
      <p class="article__meta">
        <time datetime={isoDate(date)}>{longDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post.body)} min de leitura</span>
        {updated && <><span aria-hidden="true">·</span><span>Atualizado em <time datetime={isoDate(updated)}>{longDate(updated)}</time></span></>}
        {draft && <span class="article__draft">Rascunho</span>}
      </p>
      <h1 id="article-title" class="article__title">{title}</h1>
      <p class="article__summary">{summary}</p>
      {tags.length > 0 && (
        <ul class="article__tags" aria-label="Tags">
          {tags.map((tag) => <li><a href={tagHref(tag)}>#{tag}</a></li>)}
        </ul>
      )}
    </header>

    <div class:list={['article__body', { 'article__body--toc': showToc }]}>
      {showToc && (
        <nav class="toc" aria-labelledby="toc-title">
          <details open>
            <summary id="toc-title">Sumário</summary>
            <ol>
              {toc.map((h) => (
                <li class:list={{ 'toc__sub': h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </details>
        </nav>
      )}
      <div class="prose-noir article__content">
        <Content />
      </div>
    </div>

    {(newer || older) && (
      <nav class="pager" aria-label="Outros logs">
        {older ? (
          <a href={postHref(older)} class="pager__link">
            <span class="pager__label">Anterior</span>
            <span class="pager__title">{older.data.title}</span>
          </a>
        ) : <span />}
        {newer && (
          <a href={postHref(newer)} class="pager__link pager__link--next">
            <span class="pager__label">Próximo</span>
            <span class="pager__title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    padding: 2.5rem 0 6rem;
  }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6875rem;
    color: var(--color-ash);
    transition: color 0.2s;
  }

  .article__back:hover {
    color: var(--color-paper);
  }

  .article__head {
    max-width: 46rem;
    margin-top: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-size: 0.65625rem;
    letter-spacing: 0.06em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .article__draft {
    padding: 0 0.4rem;
    border: 1px dashed var(--color-line-strong);
    color: var(--color-ash);
  }

  .article__title {
    margin-top: 0.9rem;
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
    text-wrap: balance;
  }

  .article__summary {
    margin-top: 1rem;
    font-size: 0.8125rem;
    line-height: 1.3rem;
    color: var(--color-ash);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 1.25rem;
    font-size: 0.65625rem;
    color: var(--color-smoke);
  }

  .article__tags a:hover {
    color: var(--color-paper);
  }

  .article__body {
    margin-top: 3rem;
  }

  .article__content {
    max-width: 44rem;
  }

  .article__body--toc {
    display: grid;
    grid-template-columns: minmax(0, 44rem) 15rem;
    justify-content: space-between;
    gap: 4rem;
  }

  .toc {
    order: 2;
    align-self: start;
    position: sticky;
    top: 1.5rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-line);
    font-size: 0.6875rem;
    line-height: 1.1rem;
  }

  .toc summary {
    margin-bottom: 0.75rem;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-smoke);
    cursor: pointer;
    list-style: none;
  }

  .toc summary::-webkit-details-marker {
    display: none;
  }

  .toc li + li {
    margin-top: 0.45rem;
  }

  .toc__sub {
    padding-left: 0.9rem;
  }

  .toc a {
    color: var(--color-ash);
    transition: color 0.2s;
  }

  .toc a:hover {
    color: var(--color-paper);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 44rem;
    margin-top: 4rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }

  .pager__link {
    display: grid;
    gap: 0.35rem;
  }

  .pager__link--next {
    text-align: right;
  }

  .pager__label {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .pager__title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.4rem;
    transition: color 0.2s;
  }

  .pager__link:hover .pager__title {
    color: var(--color-ash);
  }

  @media (max-width: 1023px) {
    .article__body--toc {
      display: block;
    }

    .toc {
      position: static;
      margin-bottom: 2.5rem;
    }

    .toc summary {
      list-style: revert;
    }
  }
</style>
