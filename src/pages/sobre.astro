---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { about } from '@/data/about';
import { site } from '@/data/site';
---

<BaseLayout title={about.title} description={about.description} headerIndex="05">
  <section class="site-container page" aria-labelledby="page-title">
    <PageHeader eyebrow={about.eyebrow} title={about.title} index="05" />

    <div class="about">
      <div class="about__intro">
        {about.intro.map((paragraph) => <p>{paragraph}</p>)}
        <a href={site.github} class="about__link" rel="me">
          <span>GitHub · luscamasfei</span>
          <svg width="12" height="12" viewBox="0 0 13 13" aria-hidden="true">
            <path d="M1.5 11.5 11 2M4 1.5h7.5V9" fill="none" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </a>
      </div>

      <div class="about__side">
        <section aria-labelledby="about-now">
          <h2 id="about-now" class="about__heading">// Atualmente</h2>
          <dl class="about__now">
            {about.now.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.text}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section aria-labelledby="about-tech">
          <h2 id="about-tech" class="about__heading">// Tecnologias</h2>
          <p class="about__note">{about.technologies.note}</p>
          {about.technologies.groups.map((group) => (
            <div class="about__group">
              <h3>{group.label}</h3>
              <ul class="about__tags">{group.items.map((item) => <li>{item}</li>)}</ul>
            </div>
          ))}
        </section>
      </div>
    </div>

    <blockquote class="about__quote">“{about.quote}”</blockquote>
  </section>
</BaseLayout>

<style>
  .page {
    padding: 3.5rem 0 6rem;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4rem;
    margin-top: 2.5rem;
  }

  .about__intro p {
    max-width: 32rem;
    font-size: 0.875rem;
    line-height: 1.5rem;
    color: var(--color-paper);
  }

  .about__intro p + p {
    margin-top: 1rem;
    color: var(--color-ash);
  }

  .about__link {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.72);
    font-size: 0.65625rem;
    color: var(--color-paper);
    transition: background-color 0.25s, color 0.25s;
  }

  .about__link:hover {
    background: var(--color-paper);
    color: var(--color-void);
  }

  .about__side {
    display: grid;
    gap: 2.5rem;
    align-content: start;
  }

  .about__heading {
    font-size: 0.65625rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-ash);
  }

  .about__now {
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-line);
  }

  .about__now > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.75rem;
    line-height: 1.15rem;
  }

  .about__now dt {
    color: var(--color-paper);
  }

  .about__now dd {
    color: var(--color-ash);
  }

  .about__note {
    margin-top: 0.75rem;
    max-width: 30rem;
    font-size: 0.75rem;
    line-height: 1.15rem;
    color: var(--color-ash);
  }

  .about__group {
    margin-top: 1.1rem;
  }

  .about__group h3 {
    font-size: 0.65625rem;
    font-weight: 400;
    line-height: 1rem;
    color: var(--color-smoke);
  }

  .about__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  .about__tags li {
    padding: 0 0.45rem;
    border: 1px solid var(--color-line-strong);
    font-size: 0.65625rem;
    line-height: 1.25rem;
    color: var(--color-paper);
  }

  .about__quote {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-serif);
    font-size: 1.375rem;
    line-height: 1.75rem;
    color: var(--color-paper);
  }

  @media (max-width: 1023px) {
    .about {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
