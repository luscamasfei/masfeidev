---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import GlitchWordmark from '@/components/ui/GlitchWordmark.astro';
import { about } from '@/data/about';
---

<BaseLayout title={about.title} description={about.description}>
  <section class="site-container page" aria-labelledby="page-title">
    <PageHeader eyebrow={about.eyebrow} title={about.title}>
      <GlitchWordmark slot="title" text={about.title} src="/images/sobre-glitch" width={337} height={54} inset={58} />
      <p class="intro">{about.intro}</p>
      <ul class="keywords" aria-hidden="true">
        {about.keywords.map((word) => <li>{word}</li>)}
        <li>//</li>
      </ul>
    </PageHeader>

    <section class="block" aria-labelledby="experiences-title">
      <h2 id="experiences-title" class="block__head">
        <span>// Experiências de trabalho</span>
        <span class="section-index" aria-hidden="true">[ 02 ]</span>
      </h2>
      <ul class="jobs">
        {about.experiences.map((job) => {
          const Card = job.href ? 'a' : 'article';
          return (
            <li>
              <Card class="job" href={job.href} {...(job.href && { rel: 'noopener noreferrer', target: '_blank' })}>
                <div class="job__top">
                  <h3 class:list={['job__title', { pending: !job.title }]}>{job.title ?? 'Experiência a confirmar'}</h3>
                  <p class:list={['job__period', { pending: !job.period }]}>{job.period ?? 'Período a confirmar'}</p>
                </div>
                {job.skills.length > 0
                  ? <ul class="job__skills">{job.skills.map((skill) => <li>{skill}</li>)}</ul>
                  : <p class="job__skills pending">Competências a confirmar</p>}
                <p class:list={['job__description', { pending: !job.description }]}>
                  {job.description ?? 'Descrição pendente: preencher em src/data/about.ts com os dados reais.'}
                </p>
                {job.href && (
                  <svg class="job__arrow" width="12" height="12" viewBox="0 0 13 13" aria-hidden="true">
                    <path d="M1.5 11.5 11 2M4 1.5h7.5V9" fill="none" stroke="currentColor" stroke-width="1.2" />
                  </svg>
                )}
              </Card>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="block" aria-labelledby="stacks-title">
      <h2 id="stacks-title" class="block__head">
        <span>// Stacks &amp; ferramentas</span>
        <span class="section-index" aria-hidden="true">[ 03 ]</span>
      </h2>
      <div class="stacks">
        {about.stacks.map((group) => (
          <div class="stack">
            <h3 class="stack__title">{group.title}</h3>
            <p class="stack__description">{group.description}</p>
            <ul class="stack__tags">{group.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="block block--last" aria-labelledby="contact-title">
      <p class="block__head" aria-hidden="true">
        <span>// Conexões</span>
        <span class="section-index">[ 04 ]</span>
      </p>
      <div class="contact">
        <div>
          <h2 id="contact-title" class="contact__title">{about.contact.title}</h2>
          <p class="contact__description">{about.contact.description}</p>
        </div>
        <ul class="contact__links">
          {about.contact.links.map((link) => {
            const external = link.href?.startsWith('http');
            const Card = link.href ? 'a' : 'div';
            return (
              <li>
                <Card
                  class="link"
                  href={link.href ?? undefined}
                  {...(external && { target: '_blank', rel: 'me noopener noreferrer' })}
                >
                  <svg class="link__icon" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
                    {link.icon === 'github' && (
                      <path transform="scale(1.5)" fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                    )}
                    {link.icon === 'linkedin' && (
                      <>
                        <rect x="1" y="1" width="22" height="22" rx="2.5" fill="currentColor" />
                        <g fill="var(--color-void)">
                          <circle cx="6.9" cy="6.9" r="1.75" />
                          <rect x="5.4" y="9.4" width="3" height="9.2" />
                          <path d="M10.9 9.4h2.9v1.3c.5-.9 1.6-1.5 3-1.5 2.6 0 3.4 1.6 3.4 4.1v5.3h-3v-4.7c0-1.2-.3-2.1-1.5-2.1s-1.8.9-1.8 2.1v4.7h-3z" />
                        </g>
                      </>
                    )}
                    {link.icon === 'mail' && (
                      <g fill="none" stroke="currentColor" stroke-width="1.4">
                        <rect x="1.5" y="4.5" width="21" height="15" rx="1" />
                        <path d="m2.5 5.5 9.5 7.5 9.5-7.5" />
                      </g>
                    )}
                  </svg>
                  <span class="link__text">
                    <span class="link__label">{link.label}</span>
                    <span class:list={['link__handle', { pending: !link.handle }]}>{link.handle ?? 'Em breve'}</span>
                    {external && <span class="sr-only">(abre em nova aba)</span>}
                  </span>
                  {link.href && (
                    <svg class="link__arrow" width="12" height="12" viewBox="0 0 13 13" aria-hidden="true">
                      <path d="M1.5 11.5 11 2M4 1.5h7.5V9" fill="none" stroke="currentColor" stroke-width="1.2" />
                    </svg>
                  )}
                </Card>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  /*
   * Composição da referência (1672 px): rótulo na borda do container, título e
   * texto recuados 4 px, e o detalhe das palavras preso à direita, alinhado
   * logo abaixo do topo do título.
   */
  .page {
    /* Divisórias internas da referência: mais visíveis que a linha do cabeçalho. */
    --rule: rgb(255 255 255 / 0.26);
    padding-top: 2.3125rem;
  }

  .page :global(.page-head) {
    padding-bottom: 1.25rem;
    border-bottom-color: var(--rule);
  }

  .page :global(.page-head__eyebrow) {
    letter-spacing: 0.1em;
  }

  .page :global(.page-head__title) {
    margin: 0.75rem 0 0 0.25rem;
  }

  /* Sem arte atrás do título: o fundo da página dá ao GIF algo com que se misturar. */
  .page :global(.wordmark) {
    background: var(--color-void);
  }

  .intro {
    /* Deixa livre a coluna do detalhe à direita. */
    max-width: min(52.5rem, 100% - 9rem);
    margin: 1.0625rem 0 0 0.25rem;
    font-size: 0.875rem;
    line-height: 1.3125rem;
    color: color-mix(in srgb, var(--color-paper) 50%, var(--color-ash));
  }

  .keywords {
    position: absolute;
    top: 2.5625rem;
    right: 0;
    padding: 0.125rem 0 0.125rem 1.25rem;
    border-left: 1px solid var(--rule);
    font-size: 0.65625rem;
    letter-spacing: 0.1em;
    line-height: 1.125rem;
    text-transform: uppercase;
    color: var(--color-ash);
  }

  /* Seções numeradas, separadas pela mesma divisória da apresentação. */
  .block {
    padding: 1.25rem 0 1.6875rem;
    border-bottom: 1px solid var(--rule);
  }

  .block__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-left: 0.25rem;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-paper);
  }

  /* Dois cartões de 682 px com 35 px entre eles, na largura de 1400 px. */
  .jobs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2.1875rem;
    margin-top: 0.8125rem;
  }

  .jobs > li {
    display: flex;
  }

  .job {
    position: relative;
    flex: 1;
    min-height: 7.625rem;
    padding: 0.4375rem 1.3125rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: var(--color-void);
  }

  a.job {
    transition: border-color 0.2s;
  }

  a.job:hover {
    border-color: var(--color-line-strong);
  }

  .job__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
  }

  .job__title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.75rem;
    color: var(--color-paper);
  }

  .job__period {
    flex-shrink: 0;
    font-size: 0.65625rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: var(--color-ash);
  }

  .job__skills {
    display: flex;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--color-ash);
  }

  .job__skills li + li::before {
    content: '•';
    margin-inline: 0.75rem;
  }

  .job__description {
    max-width: 32rem;
    margin-top: 0.4375rem;
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    line-height: 1.25rem;
    color: var(--color-ash);
  }

  .job__arrow {
    position: absolute;
    right: 1.3125rem;
    bottom: 1.5rem;
    color: var(--color-paper);
    transition: translate 0.2s var(--ease-glitch);
  }

  a.job:hover .job__arrow {
    translate: 2px -2px;
  }

  /* Campo ainda não informado: aparece apagado, para não passar por dado real. */
  .pending {
    color: var(--color-smoke);
    font-style: italic;
  }

  .job__title.pending {
    font-size: 1.25rem;
  }

  /*
   * Mesma grade dos cartões: a coluna "Em estudo" começa na borda do segundo
   * cartão; a da esquerda é recuada e fechada por uma linha vertical.
   */
  .stacks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2.1875rem;
    margin-top: 0.875rem;
  }

  .stack:first-child {
    margin-right: 1.9375rem;
    padding-left: 0.9375rem;
    border-right: 1px solid var(--rule);
  }

  .stack__title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.5rem;
    color: var(--color-paper);
  }

  .stack__description {
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    line-height: 1.25rem;
    color: var(--color-ash);
  }

  .stack__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.6875rem;
  }

  .stack__tags li {
    padding: 0 0.8125rem;
    border: 1px solid var(--rule);
    font-size: 0.75rem;
    line-height: 1.4375rem;
    color: var(--color-paper);
  }

  .block--last {
    border-bottom: 0;
  }

  /*
   * "Contato" numa coluna de 300 px e três cartões iguais à direita; na
   * referência os cartões param 78 px antes da borda do container.
   */
  .contact {
    display: grid;
    grid-template-columns: 17.8125rem minmax(0, 1fr);
    gap: 1.5rem 1.75rem;
    margin-top: 0.9375rem;
    padding-left: 0.9375rem;
  }

  .contact__title {
    font-family: var(--font-serif);
    font-size: 2.125rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 2.25rem;
    color: var(--color-paper);
  }

  .contact__description {
    max-width: 17.5rem;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.125rem;
    color: var(--color-ash);
  }

  .contact__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem 1.75rem;
    align-self: start;
    margin-top: 0.6875rem;
    padding-right: 4.875rem;
  }

  .contact__links > li {
    display: flex;
  }

  .link {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 1.375rem;
    min-width: 0;
    min-height: 4rem;
    padding: 0.5rem 1.125rem 0.5rem 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: var(--color-void);
  }

  a.link {
    transition: border-color 0.2s;
  }

  a.link:hover {
    border-color: rgb(255 255 255 / 0.5);
  }

  .link__icon {
    flex-shrink: 0;
    color: var(--color-paper);
  }

  .link__text {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .link__label {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.125rem;
    color: var(--color-paper);
  }

  .link__handle {
    overflow: hidden;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    line-height: 1.125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-ash);
  }

  .link__arrow {
    flex-shrink: 0;
    color: var(--color-paper);
    transition: translate 0.2s var(--ease-glitch);
  }

  a.link:hover .link__arrow {
    translate: 2px -2px;
  }

  @media (max-width: 1279px) {
    .contact__links {
      padding-right: 0;
    }
  }

  @media (max-width: 1139px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 899px) {
    .jobs,
    .stacks {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact {
      padding-left: 0;
    }

    .contact__links {
      grid-template-columns: minmax(0, 1fr);
    }

    .stack:first-child {
      margin-right: 0;
      padding-left: 0;
      border-right: 0;
    }
  }

  @media (max-width: 639px) {
    .page {
      padding-top: 2.5rem;
    }

    .intro {
      max-width: none;
      font-size: 0.8125rem;
      line-height: 1.3rem;
    }

    .keywords {
      display: none;
    }
  }
</style>
