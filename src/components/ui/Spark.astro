---
/** Four-point star used for the logo mark and the scattered sparkles. */
interface Props {
  size?: number;
  class?: string;
}

const { size = 16, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d="M12 0c.5 6.6 3.3 10.9 12 12-8.7 1.1-11.5 5.4-12 12-.5-6.6-3.3-10.9-12-12 8.7-1.1 11.5-5.4 12-12Z" />
</svg>
