---
/**
 * Subtle monochrome glitch title. Each line shows two thin horizontal slices of
 * itself, blurred only sideways, so a couple of rows of the letters trail to the
 * left or right as in the reference. During a short burst (on load, on hover
 * and occasionally) the slices jump between rows and pull further sideways.
 * The burst never runs under prefers-reduced-motion.
 */
interface Props {
  lines: readonly string[];
  as?: 'h1' | 'h2' | 'p';
  class?: string;
  id?: string;
}

const { lines, as: Tag = 'h1', class: className, id } = Astro.props;

/**
 * Resting trails per line: [top, right, bottom, left] clip insets in %. Each one
 * keeps a thin row of a single letter (first letter for the left trail, last
 * letter for the right one), so only that letter smears out, as in the reference.
 */
const trails = [
  { left: [52, 80, 45, 0], right: [79, 0, 18, 84] },
  { left: [36, 82, 61, 0], right: [56, 0, 41, 91] },
];
const inset = (v: number[]) => v.map((n) => `${n}%`).join(' ');
---

<Tag id={id} class:list={['glitch', className]} data-glitch>
  {
    lines.map((line, i) => {
      const t = trails[i % trails.length];
      return (
        <span class="glitch__line" data-text={line} style={`--trail-l:inset(${inset(t.left)});--trail-r:inset(${inset(t.right)})`}>
          {line}
        </span>
      );
    })
  }
</Tag>

<svg class="glitch__defs" aria-hidden="true" focusable="false">
  <filter id="glitch-trail-left" x="-40%" y="-20%" width="180%" height="140%">
    <feGaussianBlur stdDeviation="6 0"></feGaussianBlur>
    <feOffset dx="-12" dy="0"></feOffset>
    <feComponentTransfer><feFuncA type="linear" slope="1.7"></feFuncA></feComponentTransfer>
  </filter>
  <filter id="glitch-trail-right" x="-40%" y="-20%" width="180%" height="140%">
    <feGaussianBlur stdDeviation="6 0"></feGaussianBlur>
    <feOffset dx="12" dy="0"></feOffset>
    <feComponentTransfer><feFuncA type="linear" slope="1.7"></feFuncA></feComponentTransfer>
  </filter>
  <filter id="glitch-pull" x="-20%" y="-20%" width="140%" height="140%">
    <feGaussianBlur stdDeviation="1.5 0"></feGaussianBlur>
  </filter>
</svg>

<style>
  .glitch {
    position: relative;
    margin: 0;
  }

  .glitch__line {
    position: relative;
    display: block;
    width: fit-content;
  }

  .glitch__line::before,
  .glitch__line::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.7;
  }

  .glitch__line::before {
    clip-path: var(--trail-l);
    filter: url(#glitch-trail-left);
  }

  .glitch__line::after {
    clip-path: var(--trail-r);
    filter: url(#glitch-trail-right);
  }

  .glitch__defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .glitch.is-glitching .glitch__line::before {
    animation: glitch-pull-left 0.45s steps(1, end);
  }

  .glitch.is-glitching .glitch__line::after {
    animation: glitch-pull-right 0.45s steps(1, end);
  }

  .glitch.is-glitching .glitch__line:nth-child(2)::before,
  .glitch.is-glitching .glitch__line:nth-child(2)::after {
    animation-delay: 0.05s;
  }

  /* During a burst, sharp slices of the whole line are pulled sideways. */
  @keyframes glitch-pull-left {
    0% { clip-path: inset(24% 0 70% 0); transform: translateX(-0.07em); filter: url(#glitch-pull); opacity: 0.95; }
    25% { clip-path: inset(60% 0 33% 0); transform: translateX(-0.12em); filter: url(#glitch-pull); opacity: 0.95; }
    50% { clip-path: inset(41% 0 54% 0); transform: translateX(-0.05em); filter: url(#glitch-pull); opacity: 0.95; }
    75% { clip-path: inset(74% 0 21% 0); transform: translateX(-0.1em); filter: url(#glitch-pull); opacity: 0.95; }
  }

  @keyframes glitch-pull-right {
    0% { clip-path: inset(66% 0 28% 0); transform: translateX(0.08em); filter: url(#glitch-pull); opacity: 0.95; }
    25% { clip-path: inset(31% 0 64% 0); transform: translateX(0.05em); filter: url(#glitch-pull); opacity: 0.95; }
    50% { clip-path: inset(82% 0 13% 0); transform: translateX(0.12em); filter: url(#glitch-pull); opacity: 0.95; }
    75% { clip-path: inset(47% 0 48% 0); transform: translateX(0.07em); filter: url(#glitch-pull); opacity: 0.95; }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch.is-glitching .glitch__line::before,
    .glitch.is-glitching .glitch__line::after {
      animation: none;
    }
  }
</style>

<script>
  const BURST_MS = 520;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const el of document.querySelectorAll<HTMLElement>('[data-glitch]')) {
    let busy = false;
    const burst = () => {
      if (busy || reduced.matches || document.hidden) return;
      busy = true;
      el.classList.add('is-glitching');
      window.setTimeout(() => {
        el.classList.remove('is-glitching');
        busy = false;
      }, BURST_MS);
    };

    const schedule = () => window.setTimeout(() => (burst(), schedule()), 9000 + Math.random() * 7000);

    window.setTimeout(burst, 350);
    el.addEventListener('pointerenter', burst);
    schedule();
  }
</script>
