---
interface Props {
  lines: readonly string[];
  as?: 'h1' | 'h2' | 'p';
  class?: string;
  id?: string;
}

const { lines, as: Tag = 'h1', class: className, id } = Astro.props;
// The base excludes these rows; displaced copies restore the broken strokes.
const slices = [
  [{ top: 32, bottom: 35, shift: -0.045 }, { top: 53, bottom: 55, shift: 0.065 }, { top: 76, bottom: 80, shift: -0.025 }],
  [{ top: 28, bottom: 31, shift: 0.035 }, { top: 49, bottom: 52, shift: -0.06 }, { top: 73, bottom: 75, shift: 0.05 }],
];
---

<Tag id={id} class:list={['glitch', className]} data-glitch>
  {lines.map((line, i) => {
    const bands = slices[i % slices.length];
    const mask = `linear-gradient(to bottom, #000 0%, ${bands.map(({ top, bottom }) => `#000 ${top}%, transparent ${top}%, transparent ${bottom}%, #000 ${bottom}%`).join(', ')}, #000 100%)`;
    return (
      <span class="glitch__line">
        <span class="glitch__base" style={{ maskImage: mask }}>{line}</span>
        {bands.map(({ top, bottom, shift }, index) => (
          <span aria-hidden="true" class:list={['glitch__slice', `glitch__slice--${index}`]}
            style={`--cut: inset(${top}% -15% ${100 - bottom}% -15%); --shift: ${shift}em;`}>
            {line}
          </span>
        ))}
        <span class="glitch__trail glitch__trail--left" aria-hidden="true">{line}</span>
        <span class="glitch__trail glitch__trail--right" aria-hidden="true">{line}</span>
      </span>
    );
  })}
</Tag>

<style>
  .glitch { position: relative; margin: 0; }
  .glitch__line { position: relative; display: block; width: fit-content; isolation: isolate; }
  .glitch__base { display: block; }
  .glitch__slice, .glitch__trail {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
  }
  .glitch__slice {
    clip-path: var(--cut);
    transform: translateX(var(--shift));
  }
  /* Fine missing scanlines cut through the displaced strokes themselves. */
  .glitch__slice--1 {
    mask-image: linear-gradient(to bottom, #000 0 50%, transparent 50% 51%, #000 51%);
  }
  .glitch__trail {
    opacity: 0.65;
    filter: blur(0.35px);
    transform-origin: left center;
  }
  .glitch__trail--left {
    clip-path: inset(54% 76% 44.5% -15%);
    transform: translateX(-0.095em) scaleX(1.2);
  }
  .glitch__trail--right {
    clip-path: inset(78% -12% 20.5% 75%);
    transform: translateX(0.035em) scaleX(1.055);
  }
  .glitch__line:nth-child(even) .glitch__trail--left {
    clip-path: inset(30% 73% 68.5% -15%);
  }
  .glitch__line:nth-child(even) .glitch__trail--right {
    clip-path: inset(50% -12% 48.5% 82%);
  }
  .glitch.is-glitching .glitch__slice { animation: slice-burst 420ms steps(1, end); }
  .glitch.is-glitching .glitch__slice--1 { animation-direction: reverse; }
  .glitch.is-glitching .glitch__line:nth-child(even) .glitch__slice { animation-delay: 45ms; }
  @keyframes slice-burst {
    0%, 100% { transform: translateX(var(--shift)); }
    18% { transform: translateX(calc(var(--shift) - 0.035em)); }
    37% { transform: translateX(calc(var(--shift) + 0.055em)); }
    53%, 79% { transform: translateX(var(--shift)); }
    68% { transform: translateX(calc(var(--shift) - 0.02em)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .glitch.is-glitching .glitch__slice { animation: none; }
  }
</style>

<script>
  const BURST_MS = 520;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const el of document.querySelectorAll<HTMLElement>('[data-glitch]')) {
    let busy = false;
    const burst = () => {
      if (busy || reduced.matches || document.hidden) return;
      busy = true;
      el.classList.add('is-glitching');
      window.setTimeout(() => {
        el.classList.remove('is-glitching');
        busy = false;
      }, BURST_MS);
    };

    const schedule = () => window.setTimeout(() => (burst(), schedule()), 9000 + Math.random() * 7000);

    el.addEventListener('pointerenter', burst);
    schedule();
  }
</script>
