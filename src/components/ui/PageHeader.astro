---
/** Cabeçalho das páginas internas: rótulo, título em serifa, descrição e índice. */
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  index?: string;
}

const { eyebrow, title, description, index } = Astro.props;
---

<header class="page-head">
  <p class="page-head__eyebrow">// {eyebrow}</p>
  <h1 id="page-title" class="page-head__title"><slot name="title">{title}</slot></h1>
  {description && <p class="page-head__description">{description}</p>}
  {index && <p class="section-index page-head__index" aria-hidden="true">[ {index} ]</p>}
  <slot />
</header>

<style>
  .page-head {
    position: relative;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .page-head__eyebrow {
    font-size: 0.65625rem;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-ash);
  }

  .page-head__title {
    margin-top: 0.85rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
  }

  .page-head__description {
    margin-top: 1.1rem;
    max-width: 24rem;
    font-size: 0.75rem;
    line-height: 1.15rem;
    color: var(--color-ash);
  }

  .page-head__index {
    position: absolute;
    top: 0;
    right: 0;
  }
</style>
