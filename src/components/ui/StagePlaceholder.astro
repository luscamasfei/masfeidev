---
/** Temporary notice for routes whose content arrives in a later stage. */
interface Props {
  label: string;
  title: string;
  stage: string;
}

const { label, title, stage } = Astro.props;
---

<section class="site-container py-24">
  <p class="eyebrow">// {label}</p>
  <h1 class="mt-4 font-serif text-[2.25rem] leading-tight">{title}</h1>
  <p class="mt-4 max-w-md text-ash">Em construção. Conteúdo previsto para {stage}.</p>
</section>
