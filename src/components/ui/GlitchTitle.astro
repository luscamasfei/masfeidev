---
/**
 * Título animado fornecido pelo autor, com versão estática para movimento reduzido.
 */
interface Props {
  class?: string;
  id?: string;
}
const { class: className = '', id } = Astro.props;
---

<h1 id={id} class:list={['glitch-title', className]}>
  <span class="sr-only">Lucas Maffei</span>
  <picture>
    <source media="(prefers-reduced-motion: reduce)" srcset="/images/lucas-maffei-glitch.png" />
    <img
      src="/images/lucas-maffei-glitch.gif"
      alt=""
      aria-hidden="true"
      width="325"
      height="152"
      draggable="false"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
</h1>

<style>
  .glitch-title {
    margin: 0;
    line-height: 1;
    width: clamp(220px, 24vw, 420px);
    max-width: 100%;
  }
  .glitch-title img {
    display: block;
    width: 100%;
    height: auto;
    /* Neutralize the near-black texture before blending it into the Hero. */
    filter: contrast(1.2);
    mix-blend-mode: screen;
    mask-image:
      linear-gradient(to right, transparent, #000 3%, #000 97%, transparent),
      linear-gradient(to bottom, transparent, #000 4%, #000 96%, transparent);
    mask-composite: intersect;
    user-select: none;
    pointer-events: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
