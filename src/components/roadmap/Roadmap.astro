---
import Planet from '@/components/roadmap/Planet.astro';
import RoadmapIcon from '@/components/roadmap/RoadmapIcon.astro';
import RoadmapPanel from '@/components/roadmap/RoadmapPanel.astro';
import {
  roadmapConnections,
  roadmapIntro,
  roadmapNodes,
  roadmapStatusLabel,
  type RoadmapNode,
} from '@/data/roadmap';

// Plano do mapa desktop, medido na referência a 1672 px.
const MAP_W = 1017;
const MAP_H = 204;
// No mobile cada fase ocupa uma faixa de 100 unidades num caminho vertical.
const STEP = 100;

const index = new Map(roadmapNodes.map((node, i) => [node.id, i]));
const narrowPoint = (i: number) => ({ x: i % 2 === 0 ? 32 : 68, y: i * STEP + STEP / 2 });
const narrowH = roadmapNodes.length * STEP;

const links = roadmapConnections.flatMap(({ from, to, bend = 0 }) => {
  const a = index.get(from);
  const b = index.get(to);
  if (a === undefined || b === undefined) return [];
  const p = roadmapNodes[a].position;
  const q = roadmapNodes[b].position;
  const dx = (q.x - p.x) * 0.45;
  const m = narrowPoint(a);
  const n = narrowPoint(b);
  const dy = (n.y - m.y) * 0.5;
  return [{
    wide: `M${p.x} ${p.y}C${p.x + dx} ${p.y + bend} ${q.x - dx} ${q.y + bend} ${q.x} ${q.y}`,
    narrow: `M${m.x} ${m.y}C${m.x} ${m.y + dy} ${n.x} ${n.y - dy} ${n.x} ${n.y}`,
  }];
});

const pad = (i: number) => String(i + 1).padStart(2, '0');
const nodeStyle = (node: RoadmapNode, i: number) => {
  const narrow = narrowPoint(i);
  return [
    `--x: ${node.position.x}`,
    `--y: ${node.position.y}`,
    `--nx: ${narrow.x}%`,
    `--ny: ${(narrow.y / narrowH) * 100}%`,
  ].join('; ');
};
---

<section id="roadmap" class="roadmap" aria-labelledby="roadmap-title">
  <div class="site-container roadmap__frame">
    <div class="roadmap__intro">
      <p class="roadmap__eyebrow">// {roadmapIntro.eyebrow}</p>
      <h2 id="roadmap-title" class="roadmap__title">
        <span class="roadmap__title-line">{roadmapIntro.title[0]}<span class="roadmap__tear" aria-hidden="true"></span></span>
        <span class="roadmap__title-line">{roadmapIntro.title[1]}</span>
      </h2>
      <p class="roadmap__description">{roadmapIntro.description}</p>
    </div>

    <div class="roadmap__map" style={`--narrow-h: ${roadmapNodes.length}`}>
      <div class="roadmap__horizon" aria-hidden="true">
        <Planet class="roadmap__planet" />
      </div>

      <svg class="roadmap__paths roadmap__paths--wide" viewBox={`0 0 ${MAP_W} ${MAP_H}`} aria-hidden="true" focusable="false">
        {links.map((link) => <path d={link.wide} />)}
      </svg>
      <svg class="roadmap__paths roadmap__paths--narrow" viewBox={`0 0 100 ${narrowH}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
        {links.map((link) => <path d={link.narrow} />)}
      </svg>

      <ol class="roadmap__nodes" aria-label="Fases do roadmap">
        {roadmapNodes.map((node, i) => {
          const status = roadmapStatusLabel[node.status];
          const body = (
            <>
              <span class="node__ring"><RoadmapIcon name={node.icon} class="node__icon" /></span>
              <span class="node__tag" aria-hidden="true">{pad(i)}</span>
              <span class="node__label">
                <span class="sr-only">Fase {pad(i)}: </span>
                {node.title && <span class="node__title">{node.title}</span>}
                <span class="node__status">{status}</span>
              </span>
            </>
          );
          return (
            <li class:list={['node', `node--${node.status}`]} style={nodeStyle(node, i)}>
              {node.details ? (
                <button type="button" class="node__body" aria-expanded="false" aria-controls={`roadmap-panel-${node.id}`} data-roadmap-trigger={node.id}>
                  {body}
                </button>
              ) : (
                <div class="node__body">{body}</div>
              )}
            </li>
          );
        })}
      </ol>

      {roadmapNodes.map((node, i) => node.details && (
        <RoadmapPanel id={node.id} number={pad(i)} title={node.title} status={node.status} details={node.details} style={nodeStyle(node, i)} />
      ))}
    </div>

    <p class="section-index roadmap__index" aria-hidden="true">[ 02 ]</p>
  </div>
  <span class="roadmap__streak roadmap__streak--left" aria-hidden="true"></span>
  <span class="roadmap__streak roadmap__streak--right" aria-hidden="true"></span>
</section>

<style>
  /*
   * Desktop geometry follows the reference at 1672 px: a 204 px band with the
   * intro in the first 380 px and the map in the remaining 1017 px. Node
   * centres are stored in that 1017 × 204 plane and scaled with the map width.
   */
  .roadmap {
    position: relative;
    z-index: 2;
    scroll-margin-top: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .roadmap__frame {
    position: relative;
    display: grid;
    grid-template-columns: 23.75rem minmax(0, 1fr);
    min-height: 12.75rem;
  }

  .roadmap__intro {
    padding: 1.15rem 0 1.5rem;
  }

  .roadmap__eyebrow {
    margin-left: 0.1rem;
    font-size: 0.65625rem;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-ash);
  }

  .roadmap__title {
    margin-top: 0.7rem;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 2.125rem;
    letter-spacing: -0.005em;
    color: var(--color-paper);
  }

  .roadmap__title-line {
    position: relative;
    display: block;
    width: fit-content;
  }

  /* Static scanline tear beside "Minha", as in the reference. */
  .roadmap__tear {
    position: absolute;
    top: 0.42em;
    left: calc(100% + 0.6rem);
    width: 6.25rem;
    height: 0.6rem;
    opacity: 0.6;
    background:
      linear-gradient(to right, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.5) 60%, transparent) 0 0 / 100% 1px no-repeat,
      linear-gradient(to right, transparent 4%, rgb(255 255 255 / 0.7) 20%, rgb(255 255 255 / 0.35) 75%, transparent) 0 4px / 88% 1px no-repeat,
      linear-gradient(to right, rgb(255 255 255 / 0.5), transparent 70%) 6px 8px / 70% 1px no-repeat;
  }

  .roadmap__description {
    margin-top: 0.85rem;
    max-width: 17.5rem;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--color-ash);
  }

  .roadmap__index {
    position: absolute;
    top: 1.1rem;
    right: 0;
  }

  .roadmap__map {
    --s: calc(100cqw / 1017);
    position: relative;
    container-type: inline-size;
  }

  .roadmap__horizon {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .roadmap__horizon :global(.roadmap__planet) {
    position: absolute;
    left: -10.8%;
    bottom: 0;
    width: 92.4%;
    height: auto;
    transform: translateY(93.6%);
  }

  .roadmap__paths {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: rgb(255 255 255 / 0.4);
    stroke-width: 1.2;
    stroke-dasharray: 6 5;
  }

  .roadmap__paths--narrow {
    display: none;
  }

  .roadmap__nodes {
    position: absolute;
    inset: 0;
  }

  .node {
    position: absolute;
    left: calc(var(--x) / 1017 * 100%);
    top: calc(50% + (var(--y) - 102) * var(--s));
    width: 3.5rem;
    height: 3.5rem;
    translate: -50% -50%;
  }

  .node__body {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
  }

  button.node__body {
    cursor: pointer;
  }

  .node__ring {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1.5px solid #4e4e4e;
    border-radius: 50%;
    background: var(--color-void);
    color: #666;
    transition: border-color 0.3s, box-shadow 0.3s, color 0.3s;
  }

  .node__ring :global(.node__icon) {
    width: 1.625rem;
    height: 1.625rem;
  }

  /* Number flag joined to the ring by a short diagonal stem. */
  .node__tag {
    position: absolute;
    left: calc(100% - 0.1rem);
    top: -0.95rem;
    min-width: 1.05rem;
    padding: 0 0.22rem;
    font-size: 0.625rem;
    line-height: 0.9rem;
    text-align: center;
    background: #383838;
    color: #a8a8a8;
  }

  .node__tag::before {
    content: '';
    position: absolute;
    left: -0.42rem;
    top: calc(100% + 0.05rem);
    width: 0.6rem;
    height: 1px;
    background: #383838;
    rotate: -45deg;
    transform-origin: right center;
  }

  .node__label {
    position: absolute;
    top: calc(100% + 0.7rem);
    left: 50%;
    translate: -50% 0;
    display: grid;
    white-space: nowrap;
  }

  .node__title {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1rem;
    color: var(--color-paper);
  }

  .node__status {
    font-size: 0.65625rem;
    letter-spacing: 0.03em;
    line-height: 1rem;
    color: var(--color-smoke);
  }

  .node--building .node__status {
    text-transform: lowercase;
  }

  .node--in-progress {
    width: 3.625rem;
    height: 3.625rem;
  }

  .node--in-progress .node__ring {
    border: 2px solid var(--color-paper);
    color: var(--color-paper);
  }

  .node--in-progress .node__ring :global(.node__icon) {
    width: 1.875rem;
    height: 1.875rem;
  }

  .node--in-progress .node__tag,
  .node--in-progress .node__tag::before {
    background: var(--color-paper);
    color: var(--color-void);
  }

  .node--in-progress .node__tag::before {
    height: 2px;
  }

  .node--in-progress .node__label {
    top: calc(100% + 0.55rem);
  }

  .node--in-progress .node__status {
    color: var(--color-ash);
  }

  button.node__body:hover .node__ring,
  button.node__body[aria-expanded='true'] .node__ring {
    box-shadow: 0 0 0 0.3rem var(--color-void), 0 0 0 calc(0.3rem + 1px) rgb(255 255 255 / 0.4);
  }

  button.node__body:focus-visible {
    outline: none;
  }

  button.node__body:focus-visible .node__ring {
    box-shadow: 0 0 0 0.3rem var(--color-void), 0 0 0 calc(0.3rem + 1px) var(--color-paper);
  }

  @media (min-width: 1024px) {
    .roadmap__map :global(.panel) {
      top: 0.75rem;
      left: calc(var(--x) / 1017 * 100% + 3rem);
    }
  }

  .roadmap__streak {
    position: absolute;
    top: 80%;
    width: 4.75rem;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(to right, transparent, rgb(255 255 255 / 0.45) 35%, rgb(255 255 255 / 0.45) 65%, transparent);
  }

  .roadmap__streak--left {
    left: 1.6rem;
  }

  .roadmap__streak--right {
    right: 2rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 1639px) {
    .roadmap__streak {
      display: none;
    }
  }

  @media (max-width: 1279px) {
    .roadmap__frame {
      grid-template-columns: 19.5rem minmax(0, 1fr);
    }
  }

  /*
   * Below 1024 px the map turns into a vertical trail: phases zig-zag down the
   * page and the panel becomes a bottom sheet.
   */
  @media (max-width: 1023px) {
    .roadmap__frame {
      grid-template-columns: 1fr;
    }

    .roadmap__intro {
      padding: 2.5rem 0 1rem;
    }

    .roadmap__index {
      top: 2.5rem;
    }

    .roadmap__map {
      height: calc(var(--narrow-h) * 8.5rem);
      max-width: 30rem;
      width: 100%;
      margin-inline: auto;
    }

    .roadmap__horizon :global(.roadmap__planet) {
      left: -60%;
      width: 220%;
      transform: translateY(97%);
    }

    .roadmap__paths--wide {
      display: none;
    }

    .roadmap__paths--narrow {
      display: block;
    }

    .roadmap__paths--narrow path {
      vector-effect: non-scaling-stroke;
    }

    .roadmap__nodes {
      z-index: 1;
    }

    .node {
      left: var(--nx);
      top: var(--ny);
    }

    /* Keep the trail from running through the labels. */
    .node__label {
      padding: 0.15rem 0.4rem;
      background: var(--color-void);
    }
  }
</style>

