---
import Planet from '@/components/roadmap/Planet.astro';
import RoadmapIcon from '@/components/roadmap/RoadmapIcon.astro';
import RoadmapPanel from '@/components/roadmap/RoadmapPanel.astro';
import { roadmapIntro, roadmapNodes, roadmapStatusLabel } from '@/data/roadmap';

/*
 * Estrada horizontal gerada a partir da quantidade de fases. Uma unidade vale
 * 1 px a 1672 px de tela: o mapa visível tem 1017 × 204 unidades, como na
 * referência, e cada fase avança 219 unidades. As alturas e curvas seguem um
 * ciclo de dez; as cinco primeiras repetem a composição aprovada.
 */
const MAP_H = 204;
const START_X = 60;
const SPACING = 219;
const END_MARGIN = 81;
const WAVE_Y = [68, 76, 83, 91, 93, 88, 80, 72, 66, 64];
const WAVE_BEND = [-34, 4, 2, 16, -18, -10, 14, -12, 6, 20];

const points = roadmapNodes.map((_, i) => ({ x: START_X + i * SPACING, y: WAVE_Y[i % WAVE_Y.length] }));
const trackW = points[points.length - 1].x + END_MARGIN;
const links = points.slice(0, -1).map((p, i) => {
  const q = points[i + 1];
  const dx = (q.x - p.x) * 0.45;
  const bend = WAVE_BEND[i % WAVE_BEND.length];
  return `M${p.x} ${p.y}C${p.x + dx} ${p.y + bend} ${q.x - dx} ${q.y + bend} ${q.x} ${q.y}`;
});

const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<section id="roadmap" class="roadmap" aria-labelledby="roadmap-title">
  <div class="site-container roadmap__frame">
    <div class="roadmap__intro">
      <p class="roadmap__eyebrow">// {roadmapIntro.eyebrow}</p>
      <h2 id="roadmap-title" class="roadmap__title">
        <span class="roadmap__title-line">{roadmapIntro.title[0]}<span class="roadmap__tear" aria-hidden="true"></span></span>
        <span class="roadmap__title-line">{roadmapIntro.title[1]}</span>
      </h2>
      <p class="roadmap__description">{roadmapIntro.description}</p>

      <div class="roadmap__controls">
        <button type="button" class="roadmap__step" data-roadmap-step="-1" aria-controls="roadmap-road" aria-label="Voltar na estrada" disabled>
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M6.5 1.5 3 5l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
        </button>
        <button type="button" class="roadmap__step" data-roadmap-step="1" aria-controls="roadmap-road" aria-label="Avançar na estrada">
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M3.5 1.5 7 5 3.5 8.5" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
        </button>
      </div>
    </div>

    <div class="roadmap__map" data-roadmap-map>
      <div class="roadmap__horizon" aria-hidden="true">
        <Planet class="roadmap__planet" />
      </div>

      <div id="roadmap-road" class="roadmap__viewport" tabindex="0" role="region" aria-label="Estrada do roadmap. Arraste para os lados ou use as setas do teclado para ver as próximas fases." data-roadmap-viewport>
        <div class="roadmap__track" style={`--track-w: ${trackW}`}>
          <svg class="roadmap__paths" viewBox={`0 0 ${trackW} ${MAP_H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
            {links.map((d) => <path d={d} />)}
          </svg>

          <ol class="roadmap__nodes" aria-label="Fases do roadmap">
            {roadmapNodes.map((node, i) => {
              const body = (
                <>
                  <span class="node__ring"><RoadmapIcon name={node.icon} class="node__icon" /></span>
                  <span class="node__tag" aria-hidden="true">{pad(i)}</span>
                  <span class="node__label">
                    <span class="sr-only">Fase {pad(i)}: </span>
                    {node.title && <span class="node__title">{node.title}</span>}
                    <span class="node__status">{roadmapStatusLabel[node.status]}</span>
                  </span>
                </>
              );
              return (
                <li class:list={['node', `node--${node.status}`]} style={`--x: ${points[i].x}; --y: ${points[i].y}`}>
                  {node.details ? (
                    <button type="button" class="node__body" aria-expanded="false" aria-controls={`roadmap-panel-${node.id}`} data-roadmap-trigger={node.id}>
                      {body}
                    </button>
                  ) : (
                    <div class="node__body">{body}</div>
                  )}
                </li>
              );
            })}
          </ol>
        </div>
      </div>

      {roadmapNodes.map((node, i) => node.details && (
        <RoadmapPanel id={node.id} number={pad(i)} title={node.title} status={node.status} details={node.details} />
      ))}
    </div>

    <p class="section-index roadmap__index" aria-hidden="true">[ 02 ]</p>
  </div>
  <span class="roadmap__streak roadmap__streak--left" aria-hidden="true"></span>
  <span class="roadmap__streak roadmap__streak--right" aria-hidden="true"></span>
</section>

<style>
  /*
   * Desktop geometry follows the reference at 1672 px: a 204 px band with the
   * intro in the first 380 px and the map in the remaining 1017 px. Node
   * centres are stored in that 1017 × 204 plane and scaled with the map width.
   */
  .roadmap {
    position: relative;
    z-index: 2;
    scroll-margin-top: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .roadmap__frame {
    position: relative;
    display: grid;
    grid-template-columns: 23.75rem minmax(0, 1fr);
    min-height: 12.75rem;
  }

  .roadmap__intro {
    position: relative;
    padding: 1.15rem 0 1.5rem;
  }

  .roadmap__eyebrow {
    margin-left: 0.1rem;
    font-size: 0.65625rem;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-ash);
  }

  .roadmap__title {
    margin-top: 0.7rem;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 2.125rem;
    letter-spacing: -0.005em;
    color: var(--color-paper);
  }

  .roadmap__title-line {
    position: relative;
    display: block;
    width: fit-content;
  }

  /* Static scanline tear beside "Minha", as in the reference. */
  .roadmap__tear {
    position: absolute;
    top: 0.42em;
    left: calc(100% + 0.6rem);
    width: 6.25rem;
    height: 0.6rem;
    opacity: 0.6;
    background:
      linear-gradient(to right, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.5) 60%, transparent) 0 0 / 100% 1px no-repeat,
      linear-gradient(to right, transparent 4%, rgb(255 255 255 / 0.7) 20%, rgb(255 255 255 / 0.35) 75%, transparent) 0 4px / 88% 1px no-repeat,
      linear-gradient(to right, rgb(255 255 255 / 0.5), transparent 70%) 6px 8px / 70% 1px no-repeat;
  }

  .roadmap__description {
    margin-top: 0.85rem;
    max-width: 17.5rem;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--color-ash);
  }

  .roadmap__index {
    position: absolute;
    top: 1.1rem;
    right: 0;
  }

  .roadmap__map {
    /* Uma unidade da estrada; abaixo de ~600 px de mapa as fases não encolhem mais. */
    --s: max(100cqw / 1017, 0.6px);
    position: relative;
    container-type: inline-size;
  }

  /*
   * Janela rolável da estrada: rolagem nativa (toque, roda, teclado) sem barra
   * visível; o mouse arrasta pelo script abaixo. As bordas esmaecem enquanto
   * houver estrada escondida daquele lado.
   */
  .roadmap__viewport {
    --fade-back: 0rem;
    --fade-forward: 0rem;
    position: absolute;
    inset: 0;
    overflow: auto hidden;
    overscroll-behavior-x: contain;
    touch-action: pan-x pan-y;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    mask-image: linear-gradient(to right, transparent, #000 var(--fade-back), #000 calc(100% - var(--fade-forward)), transparent);
    transition: --fade-back 0.3s, --fade-forward 0.3s;
  }

  .roadmap__viewport::-webkit-scrollbar {
    display: none;
  }

  .roadmap__viewport[data-can-back] {
    --fade-back: 3.5rem;
  }

  .roadmap__viewport[data-can-forward] {
    --fade-forward: 3.5rem;
  }

  .roadmap__viewport.is-dragging {
    cursor: grabbing;
  }

  .roadmap__viewport:focus-visible {
    outline-offset: -1px;
  }

  /* --lead: folga antes da primeira fase, para o rótulo não encostar na borda no celular. */
  .roadmap__track {
    --lead: 0px;
    position: relative;
    width: calc(var(--lead) + var(--track-w) * var(--s));
    height: 100%;
  }

  @property --fade-back {
    syntax: '<length>';
    inherits: false;
    initial-value: 0rem;
  }

  @property --fade-forward {
    syntax: '<length>';
    inherits: false;
    initial-value: 0rem;
  }

  .roadmap__controls {
    position: absolute;
    right: 2.25rem;
    bottom: 1.6rem;
    display: flex;
    gap: 0.375rem;
  }

  .roadmap__step {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-line-strong);
    background: var(--color-void);
    color: var(--color-ash);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, opacity 0.2s;
  }

  .roadmap__step:hover:not(:disabled) {
    border-color: var(--color-paper);
    color: var(--color-paper);
  }

  .roadmap__step:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .roadmap__horizon {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .roadmap__horizon :global(.roadmap__planet) {
    position: absolute;
    left: -10.8%;
    bottom: 0;
    width: 92.4%;
    height: auto;
    transform: translateY(93.6%);
  }

  .roadmap__paths {
    position: absolute;
    top: calc(50% - 102 * var(--s));
    left: var(--lead);
    width: calc(100% - var(--lead));
    height: calc(204 * var(--s));
    overflow: visible;
    fill: none;
    stroke: rgb(255 255 255 / 0.4);
    stroke-width: 1.2;
    stroke-dasharray: 6 5;
  }

  .roadmap__nodes {
    position: absolute;
    inset: 0;
  }

  .node {
    position: absolute;
    left: calc(var(--lead) + var(--x) * var(--s));
    top: calc(50% + (var(--y) - 102) * var(--s));
    width: 3.5rem;
    height: 3.5rem;
    translate: -50% -50%;
  }

  .node__body {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
  }

  button.node__body {
    cursor: pointer;
  }

  .node__ring {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1.5px solid #4e4e4e;
    border-radius: 50%;
    background: var(--color-void);
    color: #666;
    transition: border-color 0.3s, box-shadow 0.3s, color 0.3s;
  }

  .node__ring :global(.node__icon) {
    width: 1.625rem;
    height: 1.625rem;
  }

  /* Number flag joined to the ring by a short diagonal stem. */
  .node__tag {
    position: absolute;
    left: calc(100% - 0.1rem);
    top: -0.95rem;
    min-width: 1.05rem;
    padding: 0 0.22rem;
    font-size: 0.625rem;
    line-height: 0.9rem;
    text-align: center;
    background: #383838;
    color: #a8a8a8;
  }

  .node__tag::before {
    content: '';
    position: absolute;
    left: -0.42rem;
    top: calc(100% + 0.05rem);
    width: 0.6rem;
    height: 1px;
    background: #383838;
    rotate: -45deg;
    transform-origin: right center;
  }

  .node__label {
    position: absolute;
    top: calc(100% + 0.7rem);
    left: 50%;
    translate: -50% 0;
    display: grid;
    white-space: nowrap;
  }

  .node__title {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1rem;
    color: var(--color-paper);
  }

  .node__status {
    font-size: 0.65625rem;
    letter-spacing: 0.03em;
    line-height: 1rem;
    color: var(--color-smoke);
  }

  .node--building .node__status {
    text-transform: lowercase;
  }

  .node--in-progress {
    width: 3.625rem;
    height: 3.625rem;
  }

  .node--in-progress .node__ring {
    border: 2px solid var(--color-paper);
    color: var(--color-paper);
  }

  .node--in-progress .node__ring :global(.node__icon) {
    width: 1.875rem;
    height: 1.875rem;
  }

  .node--in-progress .node__tag,
  .node--in-progress .node__tag::before {
    background: var(--color-paper);
    color: var(--color-void);
  }

  .node--in-progress .node__tag::before {
    height: 2px;
  }

  .node--in-progress .node__label {
    top: calc(100% + 0.55rem);
  }

  .node--in-progress .node__status {
    color: var(--color-ash);
  }

  button.node__body:hover .node__ring,
  button.node__body[aria-expanded='true'] .node__ring {
    box-shadow: 0 0 0 0.3rem var(--color-void), 0 0 0 calc(0.3rem + 1px) rgb(255 255 255 / 0.4);
  }

  button.node__body:focus-visible {
    outline: none;
  }

  button.node__body:focus-visible .node__ring {
    box-shadow: 0 0 0 0.3rem var(--color-void), 0 0 0 calc(0.3rem + 1px) var(--color-paper);
  }

  /* O painel fica fora da janela rolável e acompanha o nó (--anchor-x, via script). */
  @media (min-width: 1024px) {
    .roadmap__map :global(.panel) {
      top: 0.75rem;
      left: min(var(--anchor-x, 0px) + 1rem, 100% - min(25rem, 100% - 5rem));
    }
  }

  .roadmap__streak {
    position: absolute;
    top: 80%;
    width: 4.75rem;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(to right, transparent, rgb(255 255 255 / 0.45) 35%, rgb(255 255 255 / 0.45) 65%, transparent);
  }

  .roadmap__streak--left {
    left: 1.6rem;
  }

  .roadmap__streak--right {
    right: 2rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 1639px) {
    .roadmap__streak {
      display: none;
    }
  }

  @media (max-width: 1279px) {
    .roadmap__frame {
      grid-template-columns: 19.5rem minmax(0, 1fr);
    }
  }

  /* Abaixo de 1024 px a mesma estrada horizontal, abaixo da introdução. */
  @media (max-width: 1023px) {
    .roadmap__frame {
      grid-template-columns: 1fr;
    }

    .roadmap__intro {
      padding: 2.5rem 0 1rem;
    }

    .roadmap__index {
      top: 2.5rem;
    }

    .roadmap__map {
      height: 12rem;
    }

    .roadmap__controls {
      position: static;
      justify-content: flex-end;
      margin-top: 0.75rem;
    }

    .roadmap__track {
      --lead: 1.25rem;
    }

    /* Alvos de toque de 44 px. */
    .roadmap__step {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>


<script>
  import { anchorPanel } from '@/lib/roadmap-panel';

  /*
   * Estrada arrastável. Toque, roda do mouse e teclado usam a rolagem nativa
   * da janela; aqui ficam o arraste com mouse, os botões, o estado das bordas
   * e o painel acompanhando o nó. Religado a cada navegação do ClientRouter.
   */
  const DRAG_THRESHOLD = 5;
  let controller: AbortController | undefined;

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    const viewport = document.querySelector<HTMLElement>('[data-roadmap-viewport]');
    if (!viewport) return;
    controller = new AbortController();
    const { signal } = controller;
    const steps = [...document.querySelectorAll<HTMLButtonElement>('[data-roadmap-step]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const update = () => {
      const max = viewport.scrollWidth - viewport.clientWidth;
      const atStart = viewport.scrollLeft <= 1;
      const atEnd = viewport.scrollLeft >= max - 1;
      viewport.toggleAttribute('data-can-back', !atStart);
      viewport.toggleAttribute('data-can-forward', !atEnd);
      for (const step of steps) step.disabled = Number(step.dataset.roadmapStep) < 0 ? atStart : atEnd;

      const panel = viewport.parentElement?.querySelector<HTMLElement>('[data-roadmap-panel]:not([hidden])');
      const trigger = panel && viewport.querySelector<HTMLElement>(`[aria-controls="${panel.id}"]`);
      if (panel && trigger) anchorPanel(panel, trigger);
    };

    viewport.addEventListener('scroll', update, { signal, passive: true });
    const resize = new ResizeObserver(update);
    resize.observe(viewport);
    signal.addEventListener('abort', () => resize.disconnect());
    update();

    for (const step of steps) {
      step.addEventListener('click', () => {
        const left = Number(step.dataset.roadmapStep) * viewport.clientWidth * 0.6;
        viewport.scrollBy({ left, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
      }, { signal });
    }

    // Arraste com mouse: só vira arraste depois de alguns pixels, para um
    // clique simples continuar abrindo a fase.
    let drag: { x: number; left: number; pointer: number } | null = null;
    let dragged = false;

    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      drag = { x: event.clientX, left: viewport.scrollLeft, pointer: event.pointerId };
      dragged = false;
    }, { signal });

    viewport.addEventListener('pointermove', (event) => {
      if (!drag || event.pointerId !== drag.pointer) return;
      const dx = event.clientX - drag.x;
      if (!dragged) {
        if (Math.abs(dx) < DRAG_THRESHOLD) return;
        dragged = true;
        viewport.setPointerCapture(event.pointerId);
        viewport.classList.add('is-dragging');
      }
      viewport.scrollLeft = drag.left - dx;
    }, { signal });

    const endDrag = (event: PointerEvent) => {
      if (!drag || event.pointerId !== drag.pointer) return;
      drag = null;
      viewport.classList.remove('is-dragging');
    };
    viewport.addEventListener('pointerup', endDrag, { signal });
    viewport.addEventListener('pointercancel', endDrag, { signal });

    // O clique que encerra um arraste não abre fases.
    viewport.addEventListener('click', (event) => {
      if (!dragged) return;
      dragged = false;
      event.preventDefault();
      event.stopPropagation();
    }, { signal, capture: true });

    viewport.addEventListener('dragstart', (event) => event.preventDefault(), { signal });

    // Setas já rolam a janela nativamente; Home e End só rolam na vertical.
    viewport.addEventListener('keydown', (event) => {
      if (event.target !== viewport || (event.key !== 'Home' && event.key !== 'End')) return;
      event.preventDefault();
      const left = event.key === 'Home' ? 0 : viewport.scrollWidth;
      viewport.scrollTo({ left, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    }, { signal });
  });
</script>
