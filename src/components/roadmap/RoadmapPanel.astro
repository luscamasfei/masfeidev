---
/**
 * Painel de detalhes de uma fase do roadmap, aberto pelo botão do nó
 * (`data-roadmap-trigger`). Usado no mini-roadmap da home e na página /roadmap;
 * cada mapa define onde o painel aparece no desktop.
 */
import { roadmapStatusLabel, type RoadmapDetails, type RoadmapStatus } from '@/data/roadmap';

interface Props {
  id: string;
  number: string;
  title?: string;
  status: RoadmapStatus;
  details: RoadmapDetails;
  style?: string;
}

const { id, number, title, status, details, style } = Astro.props;
---

<aside id={`roadmap-panel-${id}`} class="panel" style={style} aria-labelledby={`roadmap-panel-title-${id}`} data-roadmap-panel={id} hidden>
  <header class="panel__head">
    <p class="panel__index">// Fase {number}</p>
    <button type="button" class="panel__close" data-roadmap-close>
      Fechar
      <svg width="9" height="9" viewBox="0 0 9 9" aria-hidden="true"><path d="M1 1l7 7M8 1 1 8" stroke="currentColor" stroke-width="1.1" /></svg>
    </button>
  </header>
  <h3 id={`roadmap-panel-title-${id}`} class="panel__title">{title}</h3>
  <p class="panel__status">{roadmapStatusLabel[status]}</p>
  <p class="panel__description">{details.description}</p>

  <div class="panel__group">
    <h4 class="panel__heading">Conteúdos estudados</h4>
    {details.topics.length > 0
      ? <ul class="panel__list">{details.topics.map((topic) => <li>{topic}</li>)}</ul>
      : <p class="panel__empty">Lista em preparação.</p>}
  </div>
  <div class="panel__group">
    <h4 class="panel__heading">Projetos relacionados</h4>
    {details.projects.length > 0
      ? <ul class="panel__list">{details.projects.map((item) => <li><a href={item.href}>{item.title}</a></li>)}</ul>
      : <p class="panel__empty">Nenhum projeto publicado ainda.</p>}
  </div>
  <div class="panel__group">
    <h4 class="panel__heading">Artigos relacionados</h4>
    {details.articles.length > 0
      ? <ul class="panel__list">{details.articles.map((item) => <li><a href={item.href}>{item.title}</a></li>)}</ul>
      : <p class="panel__empty">Nenhum artigo publicado ainda.</p>}
  </div>
</aside>

<style>
  .panel {
    position: absolute;
    z-index: 5;
    width: min(25rem, 100% - 5rem);
    padding: 1rem 1.15rem 1.15rem;
    border: 1px solid var(--color-line-strong);
    background: var(--color-void);
    animation: panel-in 0.28s var(--ease-glitch);
  }

  .panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .panel__index,
  .panel__heading {
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-smoke);
  }

  .panel__close {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ash);
    cursor: pointer;
    transition: color 0.2s;
  }

  .panel__close:hover {
    color: var(--color-paper);
  }

  .panel__title {
    margin-top: 0.6rem;
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 400;
    line-height: 1.75rem;
  }

  .panel__status {
    font-size: 0.6875rem;
    line-height: 1rem;
    color: var(--color-ash);
  }

  .panel__description {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    line-height: 1.15rem;
    color: var(--color-paper);
  }

  .panel__group {
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-line);
  }

  .panel__list,
  .panel__empty {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    line-height: 1.15rem;
  }

  .panel__list li::before {
    content: '— ';
    color: var(--color-smoke);
  }

  .panel__list a {
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 3px;
  }

  .panel__list a:hover {
    text-decoration-color: currentColor;
  }

  .panel__empty {
    color: var(--color-smoke);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      translate: 0 0.35rem;
    }
  }

  /* Abaixo de 1024 px o painel vira uma folha presa à base da tela. */
  @media (max-width: 1023px) {
    .panel {
      position: fixed;
      z-index: 55;
      inset: auto 0 0;
      width: auto;
      max-height: 78dvh;
      overflow-y: auto;
      padding: 1.25rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
      border-width: 1px 0 0;
      animation-name: sheet-in;
    }

    @keyframes sheet-in {
      from {
        translate: 0 100%;
      }
    }
  }
</style>

<script>
  import { anchorPanel } from '@/lib/roadmap-panel';

  // Religado a cada navegação do ClientRouter; os eventos da página anterior
  // são descartados pelo AbortController.
  let controller: AbortController | undefined;

  document.addEventListener('astro:page-load', () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const panels = new Map<string, HTMLElement>();
    for (const panel of document.querySelectorAll<HTMLElement>('[data-roadmap-panel]')) {
      panels.set(panel.dataset.roadmapPanel!, panel);
    }
    const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-roadmap-trigger]')];
    if (triggers.length === 0) return;
    let openId: string | null = null;

    const close = (restoreFocus = false) => {
      if (!openId) return;
      const trigger = triggers.find((t) => t.dataset.roadmapTrigger === openId);
      panels.get(openId)!.hidden = true;
      trigger?.setAttribute('aria-expanded', 'false');
      openId = null;
      if (restoreFocus) trigger?.focus();
    };

    const open = (id: string) => {
      close();
      const panel = panels.get(id);
      if (!panel) return;
      panel.hidden = false;
      const trigger = triggers.find((t) => t.dataset.roadmapTrigger === id);
      trigger?.setAttribute('aria-expanded', 'true');
      if (trigger) anchorPanel(panel, trigger);
      openId = id;
      panel.querySelector<HTMLElement>('[data-roadmap-close]')?.focus({ preventScroll: true });
    };

    for (const trigger of triggers) {
      trigger.addEventListener('click', () => {
        const id = trigger.dataset.roadmapTrigger!;
        if (openId === id) close();
        else open(id);
      }, { signal });
    }

    for (const button of document.querySelectorAll('[data-roadmap-close]')) {
      button.addEventListener('click', () => close(true), { signal });
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && openId) close(true);
    }, { signal });

    document.addEventListener('click', (event) => {
      if (!openId) return;
      const target = event.target as Node;
      const trigger = triggers.find((t) => t.dataset.roadmapTrigger === openId);
      if (!panels.get(openId)!.contains(target) && !trigger?.contains(target)) close();
    }, { signal });
  });
</script>
