---
import type { RoadmapIcon } from '@/data/roadmap';

interface Props {
  name: RoadmapIcon;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'java' && (
    <>
      <path d="M10.4 2.6c-1.6 1.5 1.4 2.4-.2 4.2M13.2 3.6c-1.1 1.1.9 1.7-.1 3" />
      <path d="M6 9.8h10.6v.6c0 2.6-2.1 4.7-4.7 4.7h-1.2C8.1 15.1 6 13 6 10.4z" />
      <path d="M16.4 10.8h1.1a1.6 1.6 0 0 1 0 3.2h-1.6" />
      <path d="M5.2 17.4h12.2M7 19.8h8.6" />
    </>
  )}
  {name === 'code' && <path d="M8.5 7.5 4 12l4.5 4.5M15.5 7.5 20 12l-4.5 4.5M13.4 5.5l-2.8 13" />}
  {name === 'database' && (
    <>
      <ellipse cx="12" cy="6" rx="6.5" ry="2.6" fill="currentColor" />
      <path d="M5.5 6v12c0 1.4 2.9 2.6 6.5 2.6s6.5-1.2 6.5-2.6V6" fill="currentColor" stroke="none" />
      <path d="M5.5 10c0 1.4 2.9 2.6 6.5 2.6s6.5-1.2 6.5-2.6M5.5 14c0 1.4 2.9 2.6 6.5 2.6s6.5-1.2 6.5-2.6" stroke="#040404" />
    </>
  )}
  {name === 'cube' && (
    <>
      <path d="M12 3.2 19.5 7v9.6L12 20.8 4.5 16.6V7z" fill="currentColor" />
      <path d="M4.5 7 12 11l7.5-4M12 11v9.8" stroke="#040404" />
    </>
  )}
  {name === 'brain' && (
    <>
      <path d="M11.4 5.2a3 3 0 0 0-5.3 1.4 3.1 3.1 0 0 0-2.1 4.6 3.3 3.3 0 0 0 1.4 5 3 3 0 0 0 4.5 1.9l1.5-.4z" />
      <path d="M12.6 5.2a3 3 0 0 1 5.3 1.4 3.1 3.1 0 0 1 2.1 4.6 3.3 3.3 0 0 1-1.4 5 3 3 0 0 1-4.5 1.9l-1.5-.4z" />
      <path d="M12 5v15.5M7.5 9.6c1 .2 1.8.9 2.1 1.9M16.5 9.6c-1 .2-1.8.9-2.1 1.9M7 14.2h2.6M17 14.2h-2.6" />
    </>
  )}
  {name === 'lock' && (
    <>
      <rect x="5.5" y="10.5" width="13" height="9.5" rx="1.2" />
      <path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5M12 14.2v2.4" />
    </>
  )}
</svg>
