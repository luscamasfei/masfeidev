---
import RoadmapIcon from '@/components/roadmap/RoadmapIcon.astro';
import { roadmapPageStages, roadmapStatusLabel } from '@/data/roadmap';

// A faixa da estrada na referência de 1672 px: dos cards das pontas (x 92–1597)
// a partir de y 345, logo abaixo da introdução. Horizontalmente a estrada
// acompanha a largura da faixa; verticalmente usa pixels reais (1 unidade = 1 px).
const FRAME = { left: 92, top: 345, width: 1505, height: 344 };
const points = roadmapPageStages.map((stage) => ({
  x: stage.position.x - FRAME.left,
  y: stage.position.y - FRAME.top,
}));
const links = points.slice(0, -1).map((a, i) => {
  const b = points[i + 1];
  const dx = (b.x - a.x) * 0.45;
  // A curva alterna: sobe entre 01–02 e 03–04, desce entre 02–03 e 04–05.
  const bend = i % 2 === 0 ? -34 : 34;
  return `M${a.x} ${a.y}C${a.x + dx} ${a.y + bend} ${b.x - dx} ${b.y + bend} ${b.x} ${b.y}`;
});
---

<div class="track" style={`--track-h: ${FRAME.height / 16}rem`}>
  <h2 class="sr-only">Etapas da jornada</h2>
  <svg class="track__path" viewBox={`0 0 ${FRAME.width} ${FRAME.height}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
    {links.map((d) => <path d={d} />)}
  </svg>
  <ol aria-label="Etapas da jornada" class="stages">
    {roadmapPageStages.map((stage, i) => {
      const p = points[i];
      return (
        <li id={`etapa-${stage.id}`} class:list={['stage', { 'stage--active': stage.active }]}
          aria-current={stage.active ? 'step' : undefined}
          style={`--x: ${(p.x / FRAME.width) * 100}%; --y: ${p.y / 16}rem;`}>
          <span class="stage__node" aria-hidden="true">
            <span class="stage__number">{stage.number}</span>
            <span class="stage__ring">
              {stage.icon === 'briefcase' ? (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="7" width="18" height="14" rx="2" /><path d="M8 7V4h8v3M3 12q9 5 18 0M10 13h4v3h-4z" /></svg>
              ) : <RoadmapIcon name={stage.icon} />}
            </span>
          </span>
          <div class="stage__label">
            <h3><span class="sr-only">Etapa {stage.number}: </span>{stage.title}</h3>
            <p class="stage__status">{roadmapStatusLabel[stage.status]}</p>
          </div>
          <p class="stage__summary">{stage.summary}</p>
        </li>
      );
    })}
  </ol>
</div>

<style>
  /*
   * Medidas da referência a 1672 px: nó atual 92 px, demais 72 px; título 11 px
   * abaixo do anel, selo 8 px abaixo do título e card 10 px abaixo do selo.
   * O card fica 20 px à direita do eixo do nó, sem sair da faixa.
   */
  .track {
    --card-w: 14.375rem;
    position: relative;
    height: var(--track-h);
    /* A faixa avança até 44 px nas margens, como na referência, sem causar rolagem. */
    margin-inline: calc(-1 * clamp(0rem, (100vw - 100%) / 2 - 1.25rem, 2.75rem));
    margin-top: 1.15rem;
  }

  .track__path {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgb(255 255 255 / 0.8);
    stroke-width: 1.5;
    stroke-dasharray: 6 5;
  }

  .track__path path {
    vector-effect: non-scaling-stroke;
  }

  .stages {
    position: absolute;
    inset: 0;
  }

  .stage {
    --d: 4.5rem;
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: var(--color-ash);
  }

  .stage--active {
    --d: 5.75rem;
    color: var(--color-paper);
  }

  .stage > * {
    pointer-events: auto;
  }

  .stage__node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--d);
    height: var(--d);
    translate: -50% -50%;
  }

  .stage__ring {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1.5px solid rgb(255 255 255 / 0.78);
    border-radius: 50%;
    background: var(--color-void);
  }

  .stage__ring :global(svg) {
    width: 1.875rem;
    height: 1.875rem;
  }

  .stage--active .stage__ring {
    border: 2px solid var(--color-paper);
    box-shadow: 0 0 16px rgb(255 255 255 / 0.32), inset 0 0 10px rgb(255 255 255 / 0.12);
  }

  .stage--active .stage__ring :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
  }

  .stage__number {
    position: absolute;
    top: -0.875rem;
    left: 95%;
    padding: 0.125rem 0.3125rem;
    background: #bdbdbd;
    color: var(--color-void);
    font-size: 0.65625rem;
    font-weight: 600;
    line-height: 1rem;
  }

  .stage--active .stage__number {
    background: var(--color-paper);
  }

  .stage__label {
    position: absolute;
    left: var(--x);
    top: calc(var(--y) + var(--d) / 2 + 0.6875rem);
    translate: -50% 0;
    text-align: center;
    white-space: nowrap;
  }

  h3 {
    font-size: 0.84375rem;
    font-weight: 500;
    line-height: 1rem;
    color: var(--color-paper);
  }

  .stage--active h3 {
    font-size: 0.90625rem;
  }

  .stage__status {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.62);
    background: rgb(4 4 4 / 0.7);
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-paper);
  }

  .stage__summary {
    position: absolute;
    top: calc(var(--y) + var(--d) / 2 + 4.3125rem);
    left: clamp(0rem, var(--x) + 1.25rem - var(--card-w) / 2, 100% - var(--card-w));
    width: var(--card-w);
    padding: 0.625rem 0.8125rem 0.6875rem;
    border: 1px solid rgb(255 255 255 / 0.26);
    background: rgb(4 4 4 / 0.62);
    font-size: 0.71875rem;
    line-height: 1.0625rem;
    color: #cfcfcf;
  }

  /* Abaixo de 1024 px a estrada vira uma trilha vertical: nó à esquerda, texto à direita. */
  @media (max-width: 1023px) {
    .track {
      height: auto;
      margin: 2.5rem 0 3rem;
    }

    .track__path {
      display: none;
    }

    .stages {
      position: relative;
      display: grid;
      gap: 2.5rem;
    }

    .stages::before {
      content: '';
      position: absolute;
      top: 2rem;
      bottom: 2rem;
      left: calc(2.875rem - 0.5px);
      border-left: 1.5px dashed rgb(255 255 255 / 0.6);
    }

    .stage {
      position: relative;
      inset: auto;
      display: grid;
      grid-template-columns: 5.75rem minmax(0, 1fr);
      column-gap: 1.25rem;
      align-items: start;
    }

    .stage__node {
      position: relative;
      left: auto;
      top: auto;
      grid-row: span 2;
      justify-self: center;
      translate: none;
    }

    .stage__label {
      position: static;
      translate: none;
      padding-top: 0.75rem;
      text-align: left;
      white-space: normal;
    }

    .stage__summary {
      position: static;
      grid-column: 2;
      width: auto;
      max-width: 22rem;
      margin-top: 0.625rem;
    }
  }
</style>
