---
import PageHeader from '@/components/ui/PageHeader.astro';
import RoadmapTitle from './RoadmapTitle.astro';
import { roadmapPage } from '@/data/roadmap';
---

<PageHeader eyebrow="Roadmap" title={roadmapPage.title}>
  <RoadmapTitle slot="title" />
  <p class="subtitle">{roadmapPage.subtitle}</p>
  <p class="description">{roadmapPage.description}</p>
</PageHeader>

<style>
  .subtitle {
    margin-top: 1.1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-paper);
  }

  .description {
    margin-top: 0.6rem;
    max-width: 27rem;
    font-size: 0.75rem;
    line-height: 1.15rem;
    color: var(--color-ash);
  }
</style>
