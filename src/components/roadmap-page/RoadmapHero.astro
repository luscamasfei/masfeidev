---
import { roadmapPage } from '@/data/roadmap';
---

<div class="intro">
  <p class="eyebrow">// Roadmap</p>
  <h1 id="roadmap-page-title">{roadmapPage.title}</h1>
  <p class="subtitle">{roadmapPage.subtitle}</p>
  <p class="description">{roadmapPage.description}</p>
</div>

<style>
  .intro { position: relative; isolation: isolate; max-width: 32rem; }
  .intro::before {
    content: '';
    position: absolute;
    inset: -1.25rem -2rem;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at 35% 50%, rgb(4 4 4 / 0.94) 25%, rgb(4 4 4 / 0.85) 60%, transparent 100%);
  }
  .eyebrow { color: var(--color-paper); }
  h1 {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: clamp(4rem, 5.75vw, 6rem);
    font-weight: 600;
    line-height: 1;
    color: var(--color-paper);
  }
  .subtitle {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .description {
    max-width: 27rem;
    margin-top: 1.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-line-strong);
    font-size: 0.75rem;
    line-height: 1.65;
    color: #d0d0d0;
  }
  @media (max-width: 639px) {
    .intro::before { inset: -1.25rem -0.5rem; }
  }
</style>
