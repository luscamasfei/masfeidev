---
import { roadmapPage } from '@/data/roadmap';
---

<div class="intro">
  <p class="eyebrow">// Roadmap</p>
  <h1 id="roadmap-page-title">{roadmapPage.title}</h1>
  <p class="subtitle">{roadmapPage.subtitle}</p>
  <p class="description">{roadmapPage.description}</p>
</div>

<style>
  .intro { max-width: 32rem; }
  h1 {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: clamp(4rem, 5.75vw, 6rem);
    font-weight: 600;
    line-height: 1;
    color: var(--color-paper);
  }
  .subtitle {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .description {
    max-width: 27rem;
    margin-top: 1.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-line-strong);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-ash);
  }
</style>
