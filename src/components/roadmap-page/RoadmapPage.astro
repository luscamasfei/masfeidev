---
import RoadmapHero from './RoadmapHero.astro';
import RoadmapBackground from './RoadmapBackground.astro';
import RoadmapTrack from './RoadmapTrack.astro';
import { roadmapPage } from '@/data/roadmap';
---

<section class="roadmap-page" aria-labelledby="page-title">
  <RoadmapBackground />
  <div class="site-container roadmap-page__content">
    <div class="roadmap-page__intro">
      <RoadmapHero />
      <aside class="side" aria-label="Direção da jornada">
        <blockquote>“{roadmapPage.quote[0]}<br />{roadmapPage.quote[1]}”</blockquote>
        <ul aria-label="Princípios da jornada">
          {roadmapPage.verbs.map((verb) => <li>{verb}</li>)}
          <li aria-hidden="true">//</li>
        </ul>
      </aside>
    </div>
    <RoadmapTrack />
    <div class="notes">
      {roadmapPage.notes.map((lines) => (
        <aside class="note">{lines.map((line) => <p>{line}</p>)}</aside>
      ))}
    </div>
    <p class="section-index page-index" aria-hidden="true">[ 02 ]</p>
  </div>
</section>

<style>
  .roadmap-page {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - var(--spacing-header));
  }

  .roadmap-page__content {
    padding: 3.5rem 0 6rem;
  }

  .roadmap-page__intro {
    position: relative;
    isolation: isolate;
  }

  .roadmap-page__intro :global(.page-head) {
    border-bottom: 0;
  }

  .roadmap-page__intro::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -3rem -2rem;
    max-width: 34rem;
    background: linear-gradient(to right, rgb(4 4 4 / 0.92) 70%, rgb(4 4 4 / 0.8) 85%, transparent);
    mask-image: radial-gradient(ellipse at 25% 40%, #000 25%, transparent 72%);
    pointer-events: none;
  }

  .side {
    position: absolute;
    top: 0;
    right: 0;
    max-width: 12rem;
    font-size: 0.70625rem;
    font-weight: 500;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-paper);
    text-shadow: 0 0 6px var(--color-void);
  }

  blockquote {
    text-align: right;
  }

  .side ul {
    margin-top: 2.5rem;
    padding-left: 1rem;
    border-left: 1px solid var(--color-line-strong);
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--color-ash);
  }

  .notes {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 4rem;
  }

  .note {
    padding: 1.25rem;
    border: 1px solid var(--color-line-strong);
    background: rgb(4 4 4 / 0.85);
    font-size: 0.6875rem;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-paper);
  }

  .page-index {
    margin-top: 1.5rem;
    text-align: right;
  }

  @media (max-width: 1023px) {
    .roadmap-page__intro::before {
      background: rgb(4 4 4 / 0.88);
    }

    .side {
      position: relative;
      inset: auto;
      max-width: none;
      margin-top: 1.5rem;
    }

    blockquote {
      text-align: left;
    }

    .side ul {
      display: none;
    }

    .notes {
      flex-direction: column;
      gap: 1rem;
      margin-top: 2.5rem;
    }
  }
</style>
