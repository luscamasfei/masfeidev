---
import { Picture } from 'astro:assets';
import cosmicJourney from '@/assets/roadmap/cosmic-journey.png';

// AVIF e WebP em alta qualidade: as estrelas e a textura continuam nítidas
// com uma fração do peso do PNG original (2,4 MB). As duas cópias usam os
// mesmos arquivos, então o navegador baixa a arte uma vez só.
const widths = [828, 1254, 1672];
const sizes = 'min(100vw - 2.5rem, 87.5rem)';
const pictureAttributes = { style: 'display: contents' };

// Distribuição determinística: o céu permanece estático entre renderizações.
const stars = Array.from({ length: 180 }, (_, index) => ({
  x: ((index * 7919 + 137) % 10000) / 100,
  y: ((index * 3571 + 863) % 10000) / 100,
  size: index % 13 === 0 ? 1.5 : 1,
  opacity: 0.12 + (index % 5) * 0.055,
}));
---

<div class="background" aria-hidden="true">
  <div class="background__stars">
    {stars.map((star) => (
      <span style={`left:${star.x}%;top:${star.y}%;width:${star.size}px;height:${star.size}px;opacity:${star.opacity}`} />
    ))}
  </div>
  <Picture src={cosmicJourney} formats={['avif', 'webp']} {widths} {sizes} quality={85} alt="" decoding="async" {pictureAttributes}
    loading="eager" fetchpriority="high" class="background__scene" />
  <Picture src={cosmicJourney} formats={['avif', 'webp']} {widths} {sizes} quality={85} alt="" decoding="async" {pictureAttributes}
    loading="lazy" class="background__arrival" />
</div>

<style>
  .background {
    --fade: #000 0%, #000 38%, rgb(0 0 0 / 0.97) 46%, rgb(0 0 0 / 0.9) 54%, rgb(0 0 0 / 0.77) 62%,
      rgb(0 0 0 / 0.59) 70%, rgb(0 0 0 / 0.39) 78%, rgb(0 0 0 / 0.21) 86%, rgb(0 0 0 / 0.08) 93%, transparent 100%;
    /* Curva smoothstep nas bordas: começa e termina sem quebra. */
    --edge-in: transparent 0%, rgb(0 0 0 / 0.06) 2%, rgb(0 0 0 / 0.2) 4%, rgb(0 0 0 / 0.38) 6%, rgb(0 0 0 / 0.58) 8%, rgb(0 0 0 / 0.76) 10%, rgb(0 0 0 / 0.9) 12%, #000;
    --edge-out: #000 86%, rgb(0 0 0 / 0.9) 88%, rgb(0 0 0 / 0.76) 90%, rgb(0 0 0 / 0.58) 92%, rgb(0 0 0 / 0.38) 94%, rgb(0 0 0 / 0.2) 96%, rgb(0 0 0 / 0.06) 98%, transparent 100%;
    --edge-in-y: transparent 0%, rgb(0 0 0 / 0.2) 3%, rgb(0 0 0 / 0.5) 6%, rgb(0 0 0 / 0.8) 9%, #000;
    --edge-out-y: #000 80%, rgb(0 0 0 / 0.9) 83%, rgb(0 0 0 / 0.72) 86%, rgb(0 0 0 / 0.5) 89%, rgb(0 0 0 / 0.28) 92%, rgb(0 0 0 / 0.1) 95%, rgb(0 0 0 / 0.02) 98%, transparent 100%;
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--color-void);
  }
  .background__stars {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 42%, rgb(180 185 190 / 0.035), transparent 72%);
    mask-image: radial-gradient(ellipse at 50% 40%, #000 38%, rgb(0 0 0 / 0.3) 100%);
  }
  .background__stars span {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: var(--color-paper);
  }
  .background__scene {
    position: relative;
    display: block;
    width: min(calc(100% - 2.5rem), var(--container-site));
    height: auto;
    margin-inline: auto;
    filter: brightness(0.8) contrast(1.04);
    /*
     * Máscara elíptica, centrada entre a lua e a personagem, multiplicada por
     * uma proteção estreita em cada borda: a arte some antes do limite da
     * imagem, sem cantos nem linhas retas. Todas as paradas seguem curvas
     * suaves, para a transição não formar anéis ou faixas.
     */
    mask-image:
      radial-gradient(ellipse 62% 66% at 53% 46%, var(--fade)),
      linear-gradient(to right, var(--edge-in) 14%, #000 14% 86%, var(--edge-out)),
      linear-gradient(to bottom, var(--edge-in-y) 12%, #000 12% 80%, var(--edge-out-y));
    mask-composite: intersect;
  }
  .background__arrival { display: none; }
  .background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(4 4 4 / 0.6), rgb(4 4 4 / 0.3) var(--spacing-header), rgb(4 4 4 / 0.1) 5.5rem, transparent 8rem);
  }
  /* As duas zonas preservam a lua no topo e a figura sentada no encerramento. */
  @media (max-width: 1023px) {
    .background__scene {
      height: auto;
      object-position: center top;
      mask-image: radial-gradient(ellipse at 50% 0%, #000 15%, transparent 75%);
    }
    .background__arrival {
      position: absolute;
      bottom: 0;
      display: block;
      width: min(calc(100% - 2.5rem), var(--container-site));
      left: 50%;
      transform: translateX(-50%);
      height: auto;
      filter: brightness(0.8) contrast(1.04);
      object-fit: contain;
      object-position: center bottom;
      mask-image:
        linear-gradient(to right, transparent, #000 20%, #000 80%, transparent),
        linear-gradient(to bottom, transparent 55%, #000 75%, #000 85%, transparent);
      mask-composite: intersect;
    }
  }
</style>
