---
import cosmicJourney from '@/assets/roadmap/cosmic-journey.png';

// Distribuição determinística: o céu permanece estático entre renderizações.
const stars = Array.from({ length: 180 }, (_, index) => ({
  x: ((index * 7919 + 137) % 10000) / 100,
  y: ((index * 3571 + 863) % 10000) / 100,
  size: index % 13 === 0 ? 1.5 : 1,
  opacity: 0.12 + (index % 5) * 0.055,
}));
---

<!-- PNG original: mantém estrelas e texturas sem compressão com perdas. -->
<div class="background" aria-hidden="true">
  <div class="background__stars">
    {stars.map((star) => (
      <span style={`left:${star.x}%;top:${star.y}%;width:${star.size}px;height:${star.size}px;opacity:${star.opacity}`} />
    ))}
  </div>
  <img
    src={cosmicJourney.src}
    width={cosmicJourney.width}
    height={cosmicJourney.height}
    decoding="async"
    alt=""
    loading="eager"
    fetchpriority="high"
    class="background__scene"
  />
  <img
    src={cosmicJourney.src}
    width={cosmicJourney.width}
    height={cosmicJourney.height}
    decoding="async"
    alt=""
    loading="lazy"
    class="background__arrival"
  />
</div>

<style>
  .background { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: var(--color-void); }
  .background__stars {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 42%, rgb(180 185 190 / 0.035), transparent 72%);
    mask-image: radial-gradient(ellipse at 50% 40%, #000 38%, rgb(0 0 0 / 0.3) 100%);
  }
  .background__stars span {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: var(--color-paper);
  }
  .background__scene {
    position: relative;
    display: block;
    width: min(calc(100% - 2.5rem), var(--container-site));
    height: auto;
    margin-inline: auto;
    filter: brightness(0.8) contrast(1.04);
    mask-image:
      linear-gradient(to right, transparent, rgb(0 0 0 / 0.15) 4%, rgb(0 0 0 / 0.65) 12%, #000 22%, #000 78%, rgb(0 0 0 / 0.65) 88%, rgb(0 0 0 / 0.15) 96%, transparent),
      linear-gradient(to bottom, transparent, #000 15%, #000 70%, rgb(0 0 0 / 0.65) 83%, rgb(0 0 0 / 0.15) 95%, transparent);
    mask-composite: intersect;
  }
  .background__arrival { display: none; }
  .background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(4 4 4 / 0.88) 0 var(--spacing-header), transparent 9rem);
  }
  /* As duas zonas preservam a lua no topo e a figura sentada no encerramento. */
  @media (max-width: 1023px) {
    .background__scene {
      height: auto;
      object-position: center top;
      mask-image: radial-gradient(ellipse at 50% 0%, #000 15%, transparent 75%);
    }
    .background__arrival {
      position: absolute;
      bottom: 0;
      display: block;
      width: min(calc(100% - 2.5rem), var(--container-site));
      left: 50%;
      transform: translateX(-50%);
      height: auto;
      filter: brightness(0.8) contrast(1.04);
      object-fit: contain;
      object-position: center bottom;
      mask-image:
        linear-gradient(to right, transparent, #000 20%, #000 80%, transparent),
        linear-gradient(to bottom, transparent 55%, #000 75%, #000 85%, transparent);
      mask-composite: intersect;
    }
  }
</style>
