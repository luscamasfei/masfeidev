---
import cosmicJourney from '@/assets/roadmap/cosmic-journey.png';
---

<!-- PNG original: mantém estrelas e texturas sem compressão com perdas. -->
<div class="background" aria-hidden="true">
  <img
    src={cosmicJourney.src}
    width={cosmicJourney.width}
    height={cosmicJourney.height}
    decoding="async"
    alt=""
    loading="eager"
    fetchpriority="high"
    class="background__scene"
  />
  <img
    src={cosmicJourney.src}
    width={cosmicJourney.width}
    height={cosmicJourney.height}
    decoding="async"
    alt=""
    loading="lazy"
    class="background__arrival"
  />
</div>

<style>
  .background { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .background__scene { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .background__arrival { display: none; }
  .background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(4 4 4 / 0.88) 0 var(--spacing-header), transparent 9rem);
  }
  /* As duas zonas preservam a lua no topo e a figura sentada no encerramento. */
  @media (max-width: 1023px) {
    .background__scene {
      height: 30rem;
      object-position: 65% top;
      mask-image: linear-gradient(to bottom, #000 35%, transparent 80%);
    }
    .background__arrival {
      position: absolute;
      bottom: 0;
      display: block;
      width: 100%;
      height: 28rem;
      object-fit: cover;
      object-position: center bottom;
      clip-path: inset(60% 0 0);
      mask-image: linear-gradient(to bottom, transparent 60%, #000 75%);
    }
  }
</style>
