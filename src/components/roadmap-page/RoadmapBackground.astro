---
import { Picture } from 'astro:assets';
import cosmicJourney from '@/assets/roadmap/cosmic-journey.png';
---

<div class="background" aria-hidden="true">
  <Picture
    src={cosmicJourney}
    formats={['avif', 'webp']}
    widths={[640, 1024, 1672]}
    sizes="100vw"
    alt=""
    loading="eager"
    fetchpriority="high"
    class="background__scene"
  />
  <Picture
    src={cosmicJourney}
    formats={['avif', 'webp']}
    widths={[640, 1024]}
    sizes="100vw"
    alt=""
    loading="lazy"
    class="background__arrival"
  />
</div>

<style>
  .background { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .background :global(.background__scene) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .background :global(.background__arrival) { display: none; }
  .background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(4 4 4 / 0.5), transparent 18%);
  }
  /* As duas zonas preservam a lua no topo e a figura sentada no encerramento. */
  @media (max-width: 1023px) {
    .background :global(.background__scene) {
      height: 30rem;
      object-position: 65% top;
      filter: brightness(0.7);
      mask-image: linear-gradient(to bottom, #000 35%, transparent 80%);
    }
    .background :global(.background__arrival) {
      position: absolute;
      bottom: 0;
      display: block;
      width: 100%;
      height: 40rem;
      object-fit: cover;
      object-position: center bottom;
      clip-path: inset(60% 0 0);
      mask-image: linear-gradient(to bottom, transparent 60%, #000 75%);
    }
  }
</style>
