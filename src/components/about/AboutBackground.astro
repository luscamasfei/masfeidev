---
import { Picture } from 'astro:assets';
import planetarySunrise from '@/assets/about/planetary-sunrise.png';
---

<!--
  Cenário da página /sobre: horizonte planetário, nascer do sol e planeta à
  direita, preso ao pé da página. Como na referência, a arte desce 4,25% da
  própria altura e o corte fica abaixo da tela. Nunca passa do tamanho
  original (1672 px): em telas maiores as laterais se dissolvem no preto.
-->
<div class="scene" aria-hidden="true">
  <!-- Curva de gama: escurece os tons médios e preserva o brilho do sol, como na referência. -->
  <svg width="0" height="0" class="scene__filter">
    <filter id="about-scene-tone" color-interpolation-filters="sRGB">
      <feComponentTransfer>
        <feFuncR type="gamma" exponent="2.5" />
        <feFuncG type="gamma" exponent="2.5" />
        <feFuncB type="gamma" exponent="2.5" />
      </feComponentTransfer>
    </filter>
  </svg>
  <Picture
    src={planetarySunrise}
    formats={['avif', 'webp']}
    widths={[828, 1254, 1672]}
    sizes="(min-width: 768px) min(100vw, 1672px), 896px"
    quality={85}
    alt=""
    loading="eager"
    decoding="async"
    class="scene__art"
  />
</div>

<style>
  .scene {
    /* Curva suave (smoothstep) nas laterais, como no cenário do Roadmap. */
    --edge-in: transparent 0%, rgb(0 0 0 / 0.06) 2.5%, rgb(0 0 0 / 0.2) 5%, rgb(0 0 0 / 0.38) 7.5%, rgb(0 0 0 / 0.58) 10%, rgb(0 0 0 / 0.76) 12.5%, rgb(0 0 0 / 0.9) 14.5%, #000 16%;
    --edge-out: #000 84%, rgb(0 0 0 / 0.9) 85.5%, rgb(0 0 0 / 0.76) 87.5%, rgb(0 0 0 / 0.58) 90%, rgb(0 0 0 / 0.38) 92.5%, rgb(0 0 0 / 0.2) 95%, rgb(0 0 0 / 0.06) 97.5%, transparent 100%;
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* Base do mesmo preto da página: a arte só clareia sobre ela (lighten). */
    background: var(--color-void);
  }

  .scene__filter {
    position: absolute;
  }

  .scene :global(.scene__art) {
    position: absolute;
    bottom: calc(var(--art-h) * -0.0425);
    left: 50%;
    width: min(100%, 104.5rem);
    max-width: none;
    height: auto;
    translate: -50% 0;
    mix-blend-mode: lighten;
    filter: url(#about-scene-tone);
    /* O céu de cima já é preto; as máscaras só evitam cortes retos. */
    mask-image:
      linear-gradient(to bottom, transparent, #000 12%),
      linear-gradient(to right, transparent, #000 3%, #000 97%, transparent);
    mask-composite: intersect;
  }

  /* Tela mais larga que a arte: as laterais se dissolvem no fundo, sem borda. */
  @media (min-width: 104.5625rem) {
    .scene :global(.scene__art) {
      mask-image:
        linear-gradient(to bottom, transparent, #000 12%),
        linear-gradient(to right, var(--edge-in), #000 16% 84%, var(--edge-out));
    }
  }

  /* Telas estreitas: a arte fica maior que a tela, centrada no nascer do sol. */
  @media (max-width: 767px) {
    .scene :global(.scene__art) {
      width: 56rem;
      translate: -41% 0;
      mask-image: linear-gradient(to bottom, transparent, #000 30%);
    }
  }
</style>
