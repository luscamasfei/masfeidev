---
import { isoDate, postHref, shortDate, tagHref, type Post } from '@/lib/blog';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length > 0 ? (
  <ol class="posts">
    {posts.map((post) => (
      <li class="post">
        <time class="post__date" datetime={isoDate(post.data.date)}>{shortDate(post.data.date)}</time>
        <div class="post__main">
          <h2 class="post__title">
            <a href={postHref(post)} class="post__link">{post.data.title}</a>
            {post.data.draft && <span class="post__draft">Rascunho</span>}
          </h2>
          <p class="post__summary">{post.data.summary}</p>
          {post.data.tags.length > 0 && (
            <ul class="post__tags" aria-label="Tags">
              {post.data.tags.map((tag) => <li><a href={tagHref(tag)}>#{tag}</a></li>)}
            </ul>
          )}
        </div>
        <svg class="post__arrow" width="13" height="13" viewBox="0 0 13 13" aria-hidden="true">
          <path d="M1.5 11.5 11 2M4 1.5h7.5V9" fill="none" stroke="currentColor" stroke-width="1.2" />
        </svg>
      </li>
    ))}
  </ol>
) : (
  <p class="posts__empty">Nenhum log publicado ainda.</p>
)}

<style>
  .post {
    position: relative;
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .post__date {
    padding-top: 0.45rem;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    line-height: 1rem;
    color: var(--color-smoke);
  }

  .post__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.875rem;
  }

  /* The whole row opens the post; tag links sit above this layer. */
  .post__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post__draft {
    padding: 0 0.4rem;
    border: 1px dashed var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--color-ash);
  }

  .post__summary {
    margin-top: 0.4rem;
    max-width: 38rem;
    font-size: 0.75rem;
    line-height: 1.15rem;
    color: var(--color-ash);
  }

  .post__tags {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.75rem;
    font-size: 0.65625rem;
    color: var(--color-smoke);
  }

  .post__tags a:hover {
    color: var(--color-paper);
  }

  .post__arrow {
    align-self: center;
    color: var(--color-ash);
    transition: color 0.25s, transform 0.3s var(--ease-glitch);
  }

  .post:hover .post__title a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 5px;
  }

  .post:hover .post__arrow {
    color: var(--color-paper);
    transform: translate(2px, -2px);
  }

  .posts__empty {
    padding: 2.5rem 0;
    font-size: 0.75rem;
    color: var(--color-smoke);
  }

  @media (max-width: 639px) {
    .post {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }

    .post__date {
      padding-top: 0;
    }

    .post__arrow {
      display: none;
    }
  }
</style>
