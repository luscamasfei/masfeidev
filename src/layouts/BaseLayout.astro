---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource/ibm-plex-mono/latin-300.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@/styles/global.css';

import { ClientRouter } from 'astro:transitions';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import { site } from '@/data/site';
import { glitchPage } from '@/lib/transitions';

interface Props {
  title?: string;
  description?: string;
  headerIndex?: string;
  /** Artigos ganham metadados próprios para compartilhamento. */
  article?: { published: Date; modified?: Date; tags: string[] };
}

const { title, description = site.description, article, headerIndex = '01' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#040404" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`Blog · ${site.name}`} href="/rss.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lucas Maffei, estudante de Sistemas de Informação, sobre um cenário cósmico monocromático." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
        {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <a
      href="#conteudo"
      class="fixed top-3 left-3 z-50 -translate-y-20 border border-line-strong bg-void px-3 py-2 text-[0.75rem] focus:translate-y-0"
    >
      Pular para o conteúdo
    </a>
    <SiteHeader index={headerIndex} />
    <main id="conteudo" transition:name="page" transition:animate={glitchPage}>
      <slot />
    </main>
    <div class="grain" aria-hidden="true" transition:persist></div>
  </body>
</html>
